      <p class="ycs-analysis-loading__text">Loading colors…</p>
    </div>

    <div id="ycs-analysis-swatches" class="ycs-analysis-swatches"></div>
  </div>
</div>
        </div>
      </div>
    </div>
  {% endif %}
</div>

<style>
  .ycs-analysis-app {
    max-width: 1320px;
    margin: 0 auto;
    margin-bottom: 40px;
    padding: 12px 16px 20px;
  }

  .ycs-analysis-login,
  .ycs-analysis-locked {
    max-width: 720px;
    margin: 60px auto;
    padding: 32px;
    border: 1px solid #e7e3dc;
    border-radius: 20px;
    background: #fffdf9;
    text-align: center;
  }

  .ycs-analysis-login h1,
  .ycs-analysis-locked h1 {
    margin: 0 0 12px;
  }

  .ycs-analysis-login a {
    display: inline-block;
    margin-top: 16px;
    padding: 12px 18px;
    border-radius: 999px;
    text-decoration: none;
    background: #111;
    color: #fff;
  }

  .ycs-analysis-topnav {
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .ycs-analysis-back-link {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0;
