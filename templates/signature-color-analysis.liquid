                Save with lip color
              </label>
              <label class="ycs-analysis-export-label-toggle">
                <input type="checkbox" id="ycs-analysis-export-name-left" checked>
                Save with name + color type
              </label>
              <button type="button" id="ycs-analysis-save-left" class="ycs-analysis-save-btn">
                Save Left View
              </button>
            </div>
          </div>
        </div>

        <div class="ycs-analysis-stage-panel" data-panel="right">
          <div class="ycs-analysis-photo-stage">
            <div class="ycs-analysis-photo-frame" id="ycs-analysis-frame-right">
              <div class="ycs-signature-photo-label ycs-signature-photo-label--name" data-signature-first-name></div>
<div class="ycs-signature-photo-label ycs-signature-photo-label--palette" data-signature-palette-code></div>
<div class="ycs-signature-photo-label ycs-signature-photo-label--color" data-signature-color-name-right></div>

                <img
  id="ycs-analysis-depth-drape-right"
  class="ycs-analysis-depth-stage-drape"
  alt="Right depth drape"
  hidden
/>
<img
  id="ycs-analysis-photo-right"
  class="ycs-analysis-photo-preview"
  alt="Right comparison photo"
  draggable="false"
/>

<canvas id="ycs-lip-canvas-right" class="ycs-lip-canvas"></canvas>
              <svg class="ycs-lip-svg" id="ycs-lip-svg-right" viewBox="0 0 1000 1000" preserveAspectRatio="none">
  <defs>
    <filter id="ycs-lip-blur-right">
