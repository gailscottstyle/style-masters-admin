                </label>
              </div>
              <div id="ycs-signature-left-lip-swatches" class="ycs-signature-side-swatches ycs-signature-side-swatches--lip"></div>
            </div>

            <div class="ycs-signature-side-section">
              <div class="ycs-signature-side-heading">Drape Colors</div>
              <div id="ycs-signature-left-drape-filters" class="ycs-signature-side-filters"></div>
              <div id="ycs-signature-left-drape-swatches" class="ycs-signature-side-swatches"></div>
            </div>
          </div>
        </aside>

        <div class="ycs-analysis-stage-panel" data-panel="left">
          <div class="ycs-analysis-photo-stage">
            <div class="ycs-analysis-photo-frame" id="ycs-analysis-frame-left">
