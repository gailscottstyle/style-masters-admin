                  <button type="button" id="ycs-signature-left-lip-visibility">Hide Lips</button>
                </div>
                <label class="ycs-signature-lip-opacity">
                  <span>Left opacity <strong id="ycs-signature-left-lip-opacity-value">45%</strong></span>
