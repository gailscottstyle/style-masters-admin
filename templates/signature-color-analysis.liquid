{% assign palette_access_string = '' %}

{% if customer %}
  {% assign palette_access_string = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
{% endif %}

{% capture ycs_header_content %}{{ content_for_header }}{% endcapture %}
{% assign ycs_page_url = ycs_header_content
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | replace: '\/', '/'
  | replace: '\\u0026', '&'
  | replace: '%26', '&'
  | replace: '%3F', '?'
  | replace: '%3D', '='
  | append: '&'
%}

{% assign is_admin = false %}
{% if palette_access_string contains ',YCS_ADMIN,' %}
  {% assign is_admin = true %}
{% endif %}
{% assign actual_is_admin = is_admin %}

{% assign is_trade_july_cohort = false %}
{% assign trade_july_cohort_expires_at = '2026-08-25 00:00:00 -0400' | date: '%s' %}
{% assign current_timestamp = 'now' | date: '%s' %}
{% if palette_access_string contains ',TRADEJULYCOHORT,' and current_timestamp < trade_july_cohort_expires_at %}
  {% assign is_trade_july_cohort = true %}
{% endif %}

{% assign is_trade = false %}
{% if palette_access_string contains ',TRADE,' %}
  {% assign is_trade = true %}
{% endif %}
{% if is_trade_july_cohort %}
  {% assign is_trade = true %}
{% endif %}

{% assign is_catool = false %}
{% if palette_access_string contains ',CATOOL,' %}
  {% assign is_catool = true %}
{% endif %}

{% assign is_catool_growth = false %}
{% if palette_access_string contains ',CATOOLGROWTH,' %}
  {% assign is_catool_growth = true %}
{% endif %}

{% assign admin_view_as = '' %}
{% if actual_is_admin %}
  {% if ycs_page_url contains 'viewAs=trade&' %}
    {% assign admin_view_as = 'trade' %}
  {% elsif ycs_page_url contains 'viewAs=catoolgrowth&' %}
    {% assign admin_view_as = 'catoolgrowth' %}
  {% elsif ycs_page_url contains 'viewAs=catool&' %}
    {% assign admin_view_as = 'catool' %}
  {% endif %}
{% endif %}

{% if admin_view_as != '' %}
  {% assign is_admin = false %}
  {% assign is_trade = false %}
  {% assign is_catool = false %}
  {% assign is_catool_growth = false %}

  {% if admin_view_as == 'trade' %}
    {% assign is_trade = true %}
  {% elsif admin_view_as == 'catoolgrowth' %}
    {% assign is_catool_growth = true %}
  {% elsif admin_view_as == 'catool' %}
    {% assign is_catool = true %}
  {% endif %}
{% endif %}

{% assign can_use_analysis_tool = false %}
{% if is_admin or is_trade or is_catool or is_catool_growth %}
  {% assign can_use_analysis_tool = true %}
{% endif %}

{% assign ycs_tools_view_as_query = '' %}
{% if admin_view_as != '' %}
  {% assign ycs_tools_view_as_query = '&viewAs=' | append: admin_view_as %}
{% endif %}

<div
  class="ycs-analysis-app ycs-signature-analysis-app"
  data-signature-mode="true"
  data-customer-id="{{ customer.id }}"
  data-is-admin="{% if is_admin %}true{% else %}false{% endif %}"
  data-is-trade="{% if is_trade %}true{% else %}false{% endif %}"
  data-is-catool="{% if is_catool %}true{% else %}false{% endif %}"
  data-is-catool-growth="{% if is_catool_growth %}true{% else %}false{% endif %}"
  data-can-use-analysis-tool="{% if can_use_analysis_tool %}true{% else %}false{% endif %}"
  data-actual-is-admin="{% if actual_is_admin %}true{% else %}false{% endif %}"
  data-admin-preview-role="{{ admin_view_as }}"
  data-palette-access="{{ palette_access_string }}"
  data-app-base-url=""
>
  {% if customer == nil %}
    <div class="ycs-analysis-login">
      <h1>Sign in to access the Color Analysis Tool</h1>
      <a href="{{ routes.account_login_url }}">Sign In</a>
    </div>

  {% elsif can_use_analysis_tool != true %}
  <div class="ycs-analysis-locked">
    <h1>Color Analysis Tool</h1>
    <p>This tool is not available for your account.</p>
  </div>

  {% else %}


    <div class="ycs-analysis-shell">
      <div class="ycs-analysis-topnav ycs-signature-topbar">
        <nav class="ycs-tool-nav" aria-label="Color analysis tools">


          <a href="/clients{{ ycs_tools_view_as_query | replace: '&', '?' }}" class="ycs-tool-nav__link">Clients & Members</a>
          <a id="ycs-signature-manage-client-nav-link" href="/clients" class="ycs-tool-nav__link" hidden>Manage Client</a>
          <a id="ycs-signature-photo-prep-nav-link" href="/pages/photo-prep" class="ycs-tool-nav__link">Photo Prep</a>
          <a id="ycs-signature-standard-analysis-nav-link" href="/pages/color-analysis-tool" class="ycs-tool-nav__link">Structured Analysis</a>
        </nav>
      </div>
      <div class="ycs-analysis-header">
        <p class="ycs-analysis-kicker">Style Masters</p>
        <h1 class="ycs-analysis-title">Lip & Draping Studio</h1>
        <p class="ycs-analysis-subtitle">
            Draping and lip color testing for a selected Your Color Style palette.
        </p>
      </div>

      <div class="ycs-analysis-toolbar">
  <div class="ycs-analysis-toolbar-left">
    <div class="ycs-analysis-toolbar-block ycs-analysis-toolbar-block--zoom">
      <label for="ycs-analysis-zoom-slider" class="ycs-analysis-toolbar-label">Zoom</label>
      <input
        type="range"
        id="ycs-analysis-zoom-slider"
        data-analysis-zoom
        min="0.6"
        max="3"
        step="0.01"
        value="1"
        class="ycs-analysis-range"
      />
    </div>

    <div class="ycs-analysis-toolbar-actions">
      <button type="button" id="ycs-analysis-save-position" class="ycs-analysis-save-btn">
        Save Position
      </button>
    </div>
  </div>

  <div class="ycs-analysis-toolbar-right">
    <div class="ycs-analysis-toolbar-block ycs-analysis-toolbar-block--palette">
      <label for="ycs-analysis-palette-select" class="ycs-analysis-toolbar-label">Palette</label>
      <div class="ycs-analysis-palette-select-wrap">
        <select id="ycs-analysis-palette-select" class="ycs-analysis-palette-select"></select>
      </div>
    </div>
    <label class="ycs-analysis-realistic-toggle">
      <input type="checkbox" id="ycs-analysis-realistic-drape-toggle">
      <span>Realistic fabric drape</span>
    </label>
  </div>
</div>

      <div id="ycs-analysis-loading" class="ycs-analysis-loading-panel" hidden>
        <div class="ycs-analysis-loading__dots">
          <span></span><span></span><span></span>
        </div>
        <p id="ycs-analysis-loading-text" class="ycs-analysis-loading__text">Loading photo…</p>
      </div>

      <div class="ycs-analysis-main-grid">
        <aside class="ycs-signature-side-rail ycs-signature-side-rail--left" data-signature-side="left">
