              ></button>
            </div>
          </div>

          <div class="ycs-analysis-panel-footer">
            <div class="ycs-analysis-selected">
              <span class="ycs-analysis-selected-label">Selected</span>
              <span id="ycs-analysis-selected-right" class="ycs-analysis-selected-name">—</span>
            </div>

            <div class="ycs-analysis-save-controls">
