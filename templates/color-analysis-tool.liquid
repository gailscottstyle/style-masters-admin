{% assign palette_access_string = '' %}

{% if customer %}
  {% assign palette_access_string = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
{% endif %}

{% capture ycs_header_content %}{{ content_for_header }}{% endcapture %}
{% assign ycs_page_url = ycs_header_content
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | replace: '\/', '/'
  | replace: '\\u0026', '&'
  | replace: '%26', '&'
  | replace: '%3F', '?'
  | replace: '%3D', '='
  | append: '&'
%}

{% assign is_admin = false %}
{% if palette_access_string contains ',YCS_ADMIN,' %}
  {% assign is_admin = true %}
{% endif %}
{% assign actual_is_admin = is_admin %}

{% assign is_trade_july_cohort = false %}
{% assign trade_july_cohort_expires_at = '2026-08-25 00:00:00 -0400' | date: '%s' %}
{% assign current_timestamp = 'now' | date: '%s' %}
{% if palette_access_string contains ',TRADEJULYCOHORT,' and current_timestamp < trade_july_cohort_expires_at %}
  {% assign is_trade_july_cohort = true %}
{% endif %}

{% assign is_trade = false %}
{% if palette_access_string contains ',TRADE,' %}
  {% assign is_trade = true %}
{% endif %}
{% if is_trade_july_cohort %}
  {% assign is_trade = true %}
{% endif %}

{% assign is_catool = false %}
{% if palette_access_string contains ',CATOOL,' %}
  {% assign is_catool = true %}
{% endif %}

{% assign is_catool_growth = false %}
{% if palette_access_string contains ',CATOOLGROWTH,' %}
  {% assign is_catool_growth = true %}
{% endif %}

{% assign is_catool_free = false %}
{% if palette_access_string contains ',CATOOLFREE,' %}
  {% assign is_catool_free = true %}
{% endif %}

{% assign is_free_diy_catool = false %}
{% if palette_access_string contains ',FREEDIYCATOOL,' %}
  {% assign is_free_diy_catool = true %}
{% endif %}

{% assign is_diy_catool = false %}
{% if palette_access_string contains ',DIYCATOOL,' %}
  {% assign is_diy_catool = true %}
{% endif %}

{% assign admin_view_as = '' %}
{% if actual_is_admin %}
  {% if ycs_page_url contains 'viewAs=trade&' %}
    {% assign admin_view_as = 'trade' %}
  {% elsif ycs_page_url contains 'viewAs=catoolgrowth&' %}
    {% assign admin_view_as = 'catoolgrowth' %}
  {% elsif ycs_page_url contains 'viewAs=catoolfree&' %}
    {% assign admin_view_as = 'catoolfree' %}
  {% elsif ycs_page_url contains 'viewAs=freediycatool&' %}
    {% assign admin_view_as = 'freediycatool' %}
  {% elsif ycs_page_url contains 'viewAs=diycatool&' %}
    {% assign admin_view_as = 'diycatool' %}
  {% elsif ycs_page_url contains 'viewAs=catool&' %}
    {% assign admin_view_as = 'catool' %}
  {% endif %}
{% endif %}

{% if admin_view_as != '' %}
  {% assign is_admin = false %}
  {% assign is_trade = false %}
  {% assign is_catool = false %}
  {% assign is_catool_growth = false %}
  {% assign is_catool_free = false %}
  {% assign is_free_diy_catool = false %}
  {% assign is_diy_catool = false %}

  {% if admin_view_as == 'trade' %}
    {% assign is_trade = true %}
  {% elsif admin_view_as == 'catoolgrowth' %}
    {% assign is_catool_growth = true %}
  {% elsif admin_view_as == 'catoolfree' %}
    {% assign is_catool_free = true %}
  {% elsif admin_view_as == 'freediycatool' %}
    {% assign is_free_diy_catool = true %}
  {% elsif admin_view_as == 'diycatool' %}
    {% assign is_diy_catool = true %}
  {% elsif admin_view_as == 'catool' %}
    {% assign is_catool = true %}
  {% endif %}
{% endif %}

{% assign can_use_analysis_tool = false %}
{% if is_admin or is_trade or is_catool or is_catool_growth or is_catool_free or is_diy_catool or is_free_diy_catool %}
  {% assign can_use_analysis_tool = true %}
{% endif %}

<div
  class="ycs-analysis-app"
  data-customer-id="{{ customer.id }}"
  data-is-admin="{% if is_admin %}true{% else %}false{% endif %}"
  data-is-trade="{% if is_trade %}true{% else %}false{% endif %}"
  data-is-catool="{% if is_catool %}true{% else %}false{% endif %}"
  data-is-catool-growth="{% if is_catool_growth %}true{% else %}false{% endif %}"
  data-is-catool-free="{% if is_catool_free %}true{% else %}false{% endif %}"
  data-is-free-diy-catool="{% if is_free_diy_catool %}true{% else %}false{% endif %}"
  data-is-diy-catool="{% if is_diy_catool %}true{% else %}false{% endif %}"
  data-can-use-analysis-tool="{% if can_use_analysis_tool %}true{% else %}false{% endif %}"
  data-actual-is-admin="{% if actual_is_admin %}true{% else %}false{% endif %}"
  data-admin-preview-role="{{ admin_view_as }}"
  data-palette-access="{{ palette_access_string }}"
  data-app-base-url=""
>
  {% if customer == nil %}
    <div class="ycs-analysis-login">
      <h1>Sign in to access the Color Analysis Tool</h1>
      <a href="{{ routes.account_login_url }}">Sign In</a>
    </div>

  {% elsif can_use_analysis_tool != true %}
  <div class="ycs-analysis-locked">
    <h1>Color Analysis Tool</h1>
    <p>This tool is not available for your account.</p>
  </div>

  {% else %}


    <div class="ycs-analysis-shell">
      <div class="ycs-analysis-topnav">
        <a href="/pages/photo-prep?mode=trade&workflow=color-analysis" id="ycs-analysis-back" class="ycs-analysis-back-link">
          ← Back to Client List
        </a>
      </div>
      <div class="ycs-analysis-header">
        <p class="ycs-analysis-kicker">Style Masters</p>
        <h1 class="ycs-analysis-title">Color Analysis Tool</h1>
        <p class="ycs-analysis-subtitle">
          Compare draping colors side by side on the same saved photo.
        </p>
        {% if is_diy_catool %}
          <div class="ycs-analysis-diy-palette-callout">
            <p>
              Found colors you love? Keep your best palette handy for getting dressed, shopping, and feeling pulled together every day.
            </p>
            <a href="https://yourcolorstyle.com/products/digital-color-palettes">
              Shop digital color palettes
            </a>
          </div>
        {% elsif is_free_diy_catool %}
          <div class="ycs-analysis-diy-palette-callout">
            <p>
              Ready to see this on your own photo? Unlock the DIY tool and upload your picture.
            </p>
            <a href="/clients">
              Unlock DIY tool
            </a>
          </div>
        {% elsif is_catool_free %}
          <div class="ycs-analysis-diy-palette-callout">
            <p>
              Ready to use this with your own client photos? Unlock the full Color Analysis Tool.
            </p>
            <a href="/clients">
              Unlock Color Analysis Tool
            </a>
          </div>
        {% endif %}
      </div>

      <div class="ycs-analysis-mode-switch" role="tablist" aria-label="Analysis mode">
        <button type="button" id="ycs-analysis-mode-structured" class="ycs-analysis-mode-btn is-active">
          Structured Analysis
        </button>
        <div class="ycs-analysis-mode-actions">
          {% if is_admin or is_trade or is_catool or is_catool_growth %}
            <a
              id="ycs-analysis-signature-link"
              href="/pages/signature-color-analysis"
              class="ycs-analysis-toolbar-link"
            >
              Lip & Draping Studio
            </a>
          {% endif %}
          <a id="ycs-analysis-photo-prep-link" href="/pages/photo-prep" class="ycs-analysis-toolbar-link">
            Back to Photo Prep
          </a>
          {% if is_catool_growth %}
            <button type="button" id="ycs-custom-palettes-open" class="ycs-analysis-toolbar-link ycs-analysis-toolbar-link--button">
              My Custom Palettes
            </button>
          {% endif %}
        </div>
      </div>

      <div class="ycs-analysis-toolbar">
  <div class="ycs-analysis-toolbar-left">
    <div class="ycs-analysis-toolbar-block ycs-analysis-toolbar-block--zoom">
      <label for="ycs-analysis-zoom-slider" class="ycs-analysis-toolbar-label">Zoom</label>
      <input
        type="range"
        id="ycs-analysis-zoom-slider"
        data-analysis-zoom
        min="0.6"
        max="3"
        step="0.01"
        value="1"
        class="ycs-analysis-range"
      />
    </div>

    <div class="ycs-analysis-toolbar-actions">
      <button type="button" id="ycs-analysis-save-position" class="ycs-analysis-save-btn">
        Save Position
      </button>
    </div>
  </div>

  <div class="ycs-analysis-toolbar-right">
    <div class="ycs-analysis-toolbar-block ycs-analysis-toolbar-block--palette">
      <label for="ycs-analysis-palette-select" class="ycs-analysis-toolbar-label">Palette</label>
      <div class="ycs-analysis-palette-select-wrap">
        <select id="ycs-analysis-palette-select" class="ycs-analysis-palette-select"></select>
      </div>
    </div>
    <label class="ycs-analysis-realistic-toggle">
      <input type="checkbox" id="ycs-analysis-realistic-drape-toggle">
      <span>Realistic fabric drape</span>
    </label>
  </div>
</div>

<div id="ycs-analysis-decision-summary" class="ycs-analysis-decision-summary" hidden></div>

{% if is_catool_growth %}
  <section id="ycs-custom-palettes-panel" class="ycs-custom-palettes-panel" hidden>
    <div class="ycs-custom-palettes-panel__header">
      <div>
        <h2>My Custom Palettes</h2>
        <p>Add your own colors, then group them into palettes for draping.</p>
      </div>
      <button type="button" id="ycs-custom-palettes-close" class="ycs-custom-palettes-close" aria-label="Close custom palettes">×</button>
    </div>

    <div id="ycs-custom-palettes-status" class="ycs-custom-palettes-status" hidden></div>

    <div class="ycs-custom-palettes-grid">
      <form id="ycs-custom-color-form" class="ycs-custom-palettes-form">
        <h3>Add Color</h3>
        <label>
          Color name
          <input type="text" id="ycs-custom-color-name" autocomplete="off" required>
        </label>
        <label>
          Hex code
          <input type="text" id="ycs-custom-color-hex" autocomplete="off" placeholder="#AABBCC" pattern="#?[0-9a-fA-F]{6}" required>
        </label>
        <button type="submit" class="ycs-analysis-save-btn">Add Color</button>
      </form>

      <form id="ycs-custom-palette-form" class="ycs-custom-palettes-form">
        <h3>Create Palette</h3>
        <label>
          Palette name
          <input type="text" id="ycs-custom-palette-name" autocomplete="off" required>
        </label>
        <button type="submit" class="ycs-analysis-save-btn">Create Palette</button>
      </form>

      <form id="ycs-custom-palette-add-form" class="ycs-custom-palettes-form ycs-custom-palettes-form--wide">
        <h3>Add Colors to Palette</h3>
        <label>
          Palette
          <select id="ycs-custom-palette-target"></select>
        </label>
        <div id="ycs-custom-color-checkboxes" class="ycs-custom-color-checkboxes"></div>
        <button type="submit" class="ycs-analysis-save-btn">Add Selected Colors</button>
      </form>
    </div>

    <div class="ycs-custom-palettes-lists">
      <div>
        <h3>Colors</h3>
        <div id="ycs-custom-colors-list" class="ycs-custom-colors-list"></div>
      </div>
      <div>
        <h3>Palettes</h3>
        <div id="ycs-custom-palettes-list" class="ycs-custom-palettes-list"></div>
      </div>
    </div>
  </section>
{% endif %}

      <div id="ycs-analysis-loading" class="ycs-analysis-loading-panel" hidden>
        <div class="ycs-analysis-loading__dots">
          <span></span><span></span><span></span>
        </div>
        <p id="ycs-analysis-loading-text" class="ycs-analysis-loading__text">Loading photo…</p>
      </div>

      <div class="ycs-analysis-main-grid">
        <aside class="ycs-analysis-comparison-rail ycs-analysis-comparison-rail--left" hidden>
          <div class="ycs-analysis-comparison-side">
            <label for="ycs-analysis-left-palette-select" class="ycs-analysis-toolbar-label">Left Palette</label>
            <select id="ycs-analysis-left-palette-select" class="ycs-analysis-palette-select"></select>
            <div id="ycs-analysis-left-comparison-filters" class="ycs-analysis-comparison-filters"></div>
            <div id="ycs-analysis-left-comparison-swatches" class="ycs-analysis-comparison-swatches"></div>
          </div>
        </aside>

        <div class="ycs-analysis-stage-panel" data-panel="left">
          <div class="ycs-analysis-photo-stage">
            <div class="ycs-analysis-photo-frame" id="ycs-analysis-frame-left">
  <img
    id="ycs-analysis-depth-drape-left"
    class="ycs-analysis-depth-stage-drape"
    alt="Left depth drape"
    hidden
  />

  <img
    id="ycs-analysis-photo-left"
    class="ycs-analysis-photo-preview"
    alt="Left comparison photo"
    draggable="false"
  />

  <canvas id="ycs-lip-canvas-left" class="ycs-lip-canvas"></canvas>

        <svg class="ycs-lip-svg" id="ycs-lip-svg-left" viewBox="0 0 1000 1000" preserveAspectRatio="none">
  <defs>
    <filter id="ycs-lip-blur-left">
      <feGaussianBlur stdDeviation="3.5" />
    </filter>

    <filter id="ycs-lip-highlight-blur-left">
      <feGaussianBlur stdDeviation="2.2" />
    </filter>

    <linearGradient id="ycs-lip-gradient-left" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.18"></stop>
      <stop offset="22%" stop-color="#ffffff" stop-opacity="0.08"></stop>
      <stop offset="45%" stop-color="#000000" stop-opacity="0.03"></stop>
      <stop offset="72%" stop-color="#000000" stop-opacity="0.10"></stop>
      <stop offset="100%" stop-color="#000000" stop-opacity="0.18"></stop>
    </linearGradient>
  </defs>

  <path id="ycs-lip-path-left-blur" class="ycs-lip-color-layer" fill="none"></path>
<path id="ycs-lip-path-left" class="ycs-lip-color-layer" fill="none"></path>
<path id="ycs-lip-path-left-shade" class="ycs-lip-shade-layer" fill="none"></path>
<path id="ycs-lip-path-left-highlight" class="ycs-lip-highlight-layer" fill="none"></path>
  <g id="ycs-lip-guides-left"></g>
</svg>

        <div class="ycs-analysis-drape-wrap">
                <svg
                  class="ycs-analysis-drape-svg"
                  viewBox="0 0 1000 500"
                  preserveAspectRatio="none"
                >
                <defs>
                  <clipPath id="ycs-analysis-drape-clip-left">
                    <use href="#ycs-analysis-drape-left"></use>
                  </clipPath>
                </defs>
                <path
                    id="ycs-analysis-drape-left"
                    d="M0,235 Q160,170 320,182 Q500,310 680,182 Q840,170 1000,235 L1000,500 L0,500 Z"
                    fill="#e8dfd4"
                  />
                  <foreignObject
                    class="ycs-analysis-drape-overlay-object"
                    x="0"
                    y="0"
                    width="1000"
                    height="500"
                    clip-path="url(#ycs-analysis-drape-clip-left)"
                  >
                    <div xmlns="http://www.w3.org/1999/xhtml" class="ycs-analysis-drape-overlay"></div>
                  </foreignObject>
                </svg>
        </div>
              <button
                type="button"
                class="ycs-analysis-drag-layer"
                data-panel="left"
                aria-label="Drag photo"
              ></button>
            </div>
          </div>

          <div class="ycs-analysis-panel-footer">
            <div class="ycs-analysis-selected">
              <span class="ycs-analysis-selected-label">Applied</span>
              <span id="ycs-analysis-selected-left" class="ycs-analysis-selected-name">—</span>
            </div>

            <div class="ycs-analysis-save-controls">
              <label class="ycs-analysis-export-label-toggle">
                <input type="checkbox" id="ycs-analysis-export-label-left" checked>
                Save with color name
              </label>
              <button type="button" id="ycs-analysis-save-left" class="ycs-analysis-save-btn">
                Save Left View
              </button>
            </div>
          </div>
        </div>

        <div class="ycs-analysis-stage-panel" data-panel="right">
          <div class="ycs-analysis-photo-stage">
            <div class="ycs-analysis-photo-frame" id="ycs-analysis-frame-right">

                <img
  id="ycs-analysis-depth-drape-right"
  class="ycs-analysis-depth-stage-drape"
  alt="Right depth drape"
  hidden
/>
<img
  id="ycs-analysis-photo-right"
  class="ycs-analysis-photo-preview"
  alt="Right comparison photo"
  draggable="false"
/>

<canvas id="ycs-lip-canvas-right" class="ycs-lip-canvas"></canvas>
              <svg class="ycs-lip-svg" id="ycs-lip-svg-right" viewBox="0 0 1000 1000" preserveAspectRatio="none">
  <defs>
    <filter id="ycs-lip-blur-right">
      <feGaussianBlur stdDeviation="5" />
    </filter>

    <filter id="ycs-lip-highlight-blur-right">
      <feGaussianBlur stdDeviation="5" />
    </filter>

    <linearGradient id="ycs-lip-gradient-right" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.18"></stop>
      <stop offset="22%" stop-color="#ffffff" stop-opacity="0.08"></stop>
      <stop offset="45%" stop-color="#000000" stop-opacity="0.03"></stop>
      <stop offset="72%" stop-color="#000000" stop-opacity="0.10"></stop>
      <stop offset="100%" stop-color="#000000" stop-opacity="0.18"></stop>
    </linearGradient>
  </defs>

  <path id="ycs-lip-path-right-blur" class="ycs-lip-color-layer" fill="none"></path>
<path id="ycs-lip-path-right" class="ycs-lip-color-layer" fill="none"></path>
<path id="ycs-lip-path-right-shade" class="ycs-lip-shade-layer" fill="none"></path>
<path id="ycs-lip-path-right-highlight" class="ycs-lip-highlight-layer" fill="none"></path>
  <g id="ycs-lip-guides-right"></g>
</svg>
              <div class="ycs-analysis-drape-wrap">
                <svg
                  class="ycs-analysis-drape-svg"
                  viewBox="0 0 1000 500"
                  preserveAspectRatio="none"
                >
                  <defs>
                    <clipPath id="ycs-analysis-drape-clip-right">
                      <use href="#ycs-analysis-drape-right"></use>
                    </clipPath>
                  </defs>
                  <path
                    id="ycs-analysis-drape-right"
                    d="M0,235 Q160,170 320,182 Q500,310 680,182 Q840,170 1000,235 L1000,500 L0,500 Z"
                    fill="#e8dfd4"
                  />
                  <foreignObject
                    class="ycs-analysis-drape-overlay-object"
                    x="0"
                    y="0"
                    width="1000"
                    height="500"
                    clip-path="url(#ycs-analysis-drape-clip-right)"
                  >
                    <div xmlns="http://www.w3.org/1999/xhtml" class="ycs-analysis-drape-overlay"></div>
                  </foreignObject>
                </svg>
              </div>
              <button
                type="button"
                class="ycs-analysis-drag-layer"
                data-panel="right"
                aria-label="Drag photo"
              ></button>
            </div>
          </div>

          <div class="ycs-analysis-panel-footer">
            <div class="ycs-analysis-selected">
              <span class="ycs-analysis-selected-label">Selected</span>
              <span id="ycs-analysis-selected-right" class="ycs-analysis-selected-name">—</span>
            </div>

            <div class="ycs-analysis-save-controls">
              <label class="ycs-analysis-export-label-toggle">
                <input type="checkbox" id="ycs-analysis-export-label-right" checked>
                Save with color name
              </label>
              <button type="button" id="ycs-analysis-save-right" class="ycs-analysis-save-btn">
                Save Right View
              </button>
            </div>
          </div>
        </div>

        <aside class="ycs-analysis-comparison-rail ycs-analysis-comparison-rail--right" hidden>
          <div class="ycs-analysis-comparison-side">
            <label for="ycs-analysis-right-palette-select" class="ycs-analysis-toolbar-label">Right Palette</label>
            <select id="ycs-analysis-right-palette-select" class="ycs-analysis-palette-select"></select>
            <div id="ycs-analysis-right-comparison-filters" class="ycs-analysis-comparison-filters"></div>
            <div id="ycs-analysis-right-comparison-swatches" class="ycs-analysis-comparison-swatches"></div>
          </div>
        </aside>
<!-- RIGHT PANEL -->
<div id="ycs-analysis-guided-panel" class="ycs-analysis-guided-panel" hidden>
  <div id="ycs-analysis-depth-step" class="ycs-analysis-guided-step">
    <div class="ycs-analysis-guided-header">
      <h2 class="ycs-analysis-guided-title">Depth</h2>
      <p class="ycs-analysis-guided-copy">
        Compare light, medium, and deep grayscale drapes first. Choose the depth that brings the face into focus best.
      </p>
    </div>

    <div class="ycs-analysis-depth-toolbar">
      <label class="ycs-analysis-checkbox">
        <input type="checkbox" id="ycs-analysis-grayscale-toggle" />
        View photo in grayscale
      </label>
    </div>

    <div class="ycs-analysis-step-apply-row">
      <span class="ycs-analysis-apply-label">Apply to</span>
      <div class="ycs-analysis-panel-toggle">
        <button
          type="button"
          class="ycs-analysis-toggle-btn is-active"
          data-panel="left"
          id="ycs-analysis-toggle-left"
          aria-pressed="true"
        >
          Left
        </button>
        <button
          type="button"
          class="ycs-analysis-toggle-btn"
          data-panel="right"
          id="ycs-analysis-toggle-right"
          aria-pressed="false"
        >
          Right
        </button>
      </div>
    </div>

    <div id="ycs-analysis-depth-sections" class="ycs-analysis-depth-sections"></div>
  </div>

  <div id="ycs-analysis-undertone-step" class="ycs-analysis-guided-step" hidden>
    <div class="ycs-analysis-guided-header">
      <h2 class="ycs-analysis-guided-title">Undertones</h2>
      <p class="ycs-analysis-guided-copy">
        Now compare warm vs cool within the selected depth.
      </p>
    </div>

    <button
      type="button"
      id="ycs-analysis-reset-depth"
      class="ycs-analysis-reset-link"
    >
      ← Back to Depth
    </button>

    <div class="ycs-analysis-step-apply-row">
      <span class="ycs-analysis-apply-label">Apply to</span>
      <div class="ycs-analysis-panel-toggle">
        <button
          type="button"
          class="ycs-analysis-toggle-btn is-active"
          data-panel="left"
          aria-pressed="true"
        >
          Left
        </button>
        <button
          type="button"
          class="ycs-analysis-toggle-btn"
          data-panel="right"
          aria-pressed="false"
        >
          Right
        </button>
      </div>
    </div>

    <div class="ycs-lip-panel">
      <div class="ycs-lip-header">
        <strong>Lip Color</strong>
      </div>

      <div id="ycs-lip-empty-mode" class="ycs-lip-mode is-active">
        <div class="ycs-lip-actions">
          <button id="ycs-lip-edit" type="button">Create Lips</button>
        </div>
        <div id="ycs-lip-status" class="ycs-lip-status">
          Create a lip shape to test lip colors.
        </div>
      </div>

      <div id="ycs-lip-use-mode" class="ycs-lip-mode" hidden>
  <div class="ycs-lip-actions-inline">
    <button id="ycs-lip-edit-again" type="button">Edit</button>
    <button id="ycs-lip-visibility-toggle" type="button">Hide Lips</button>
  </div>

  <div class="ycs-lip-opacity-row">
