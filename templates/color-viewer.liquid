<script>
  document.addEventListener('DOMContentLoaded', async function () {
    const page = document.getElementById('ycs-color-page');
    if (!page) return;
    const nameEl = document.getElementById('ycs-color-name');
    const closeBtn = document.getElementById('ycs-color-close');
    const prevBtn = document.getElementById('ycs-color-prev');
    const nextBtn = document.getElementById('ycs-color-next');
    const favoriteBtn = document.getElementById('ycs-color-favorite-btn');
    const favoriteLabel = document.getElementById('ycs-color-fav-label');
    const openCombosBtn = document.getElementById('ycs-open-combos');
    const closeCombosBtn = document.getElementById('ycs-close-combos');
    const closeCombosTextBtn = document.getElementById('ycs-close-combos-text');
    const drawer = document.getElementById('ycs-combo-drawer');
    const drawerScrim = document.getElementById('ycs-combo-drawer-scrim');
    const combosGrid = document.getElementById('ycs-color-combos-grid');
    const shuffleBtn = document.getElementById('ycs-color-combos-shuffle');
    const comboHint = document.getElementById('ycs-combo-hint');
    const upsellModal = document.getElementById('ycs-upsell-modal');
    const upsellClose = document.getElementById('ycs-upsell-close');
    const upsellCloseBtn = document.getElementById('ycs-upsell-close-btn');
    const wardrobeDrawer = document.getElementById('ycs-wardrobe-drawer');
    const wardrobeDrawerScrim = document.getElementById('ycs-wardrobe-drawer-scrim');
    const openWardrobeBtn = document.getElementById('ycs-open-wardrobe');
    const closeWardrobeBtn = document.getElementById('ycs-close-wardrobe');
    const closeWardrobeTextBtn = document.getElementById('ycs-close-wardrobe-text');
    const wardrobeBodyEl = document.getElementById('ycs-wardrobe-body');
    const wardrobeStatusEl = document.getElementById('ycs-wardrobe-status');

    const customerId = page.dataset.customerId || null;
    const email = page.dataset.customerEmail || null;
    const accessIsAdmin = page.dataset.isAdmin === 'true';
    const isStyleMasters = page.dataset.isStyleMasters === 'true';
    const paletteAccessString = (page.dataset.paletteAccess || '').toUpperCase();
    const APP_BASE_URL = (page.dataset.appBaseUrl || '').replace(/\/$/, '');
    const wardrobeApiBase = APP_BASE_URL ? APP_BASE_URL + '/api/wardrobes' : '';

const hasPaidDrapingAccess =
  paletteAccessString.includes(',DRAPINGSTUDIOSTARTER,') ||
  paletteAccessString.includes(',DRAPINGSTUDIO,') ||
  paletteAccessString.includes(',VIP,') ||
  paletteAccessString.includes(',YCS_ADMIN,');

    const isLoggedIn = !!customerId;
    const CUSTOMER_ID = customerId;

    const params = new URLSearchParams(window.location.search);
    const urlHex = (params.get('hex') || 'FFFFFF').replace('#', '').trim().toUpperCase();
    const urlName = params.get('name') || 'Color';
    const rawPaletteCode = (params.get('palette') || '').trim();
    const paletteCode = rawPaletteCode.toUpperCase().startsWith('CUSTOM_') ? 'CUSTOM_' + rawPaletteCode.slice(7) : rawPaletteCode.toUpperCase();

    const openPhotoStudioBtn = document.getElementById('ycs-open-photo-studio');
    if (openPhotoStudioBtn) {
  if (isStyleMasters) {
    openPhotoStudioBtn.textContent = 'Try in Photo Draping Studio';
  } else {
    openPhotoStudioBtn.textContent = 'Try This on Your Face';
  }
}

    let colors = [];
    let currentIndex = 0;
    let startX = 0;
    let startY = 0;
    let favoriteHexes = new Set();
    let comboVariantIndex = 0;
    let photoStudioUrl = '';
    let wardrobeState = {
      wardrobes: [],
      selectedColors: []
    };

    function canAccess(featureKey) {
      return !!window.YCS_ACCESS?.features?.[featureKey];
    }

    window.YCS_ACCESS = {
      customerId,
      email,
      isLoggedIn,
      isAdmin: accessIsAdmin,
      isStyleMasters,
      features: {
        favorites: isLoggedIn,
        color_combos: true
      }
    };

    if (openCombosBtn) {
      openCombosBtn.textContent = canAccess('color_combos') ? 'See Color Combos' : 'Unlock Color Combos';
    }

    function openUpsell() {
      if (!upsellModal) return;
      upsellModal.classList.add('is-open');
      upsellModal.setAttribute('aria-hidden', 'false');
    }

    function closeUpsell() {
      if (!upsellModal) return;
      upsellModal.classList.remove('is-open');
      upsellModal.setAttribute('aria-hidden', 'true');
    }

    function setWardrobeStatus(message, isError) {
      if (!wardrobeStatusEl) return;
      wardrobeStatusEl.hidden = !message;
      wardrobeStatusEl.textContent = message || '';
      wardrobeStatusEl.style.borderColor = isError ? '#f2c8d3' : '#cfe3d4';
      wardrobeStatusEl.style.background = isError ? '#fff5f7' : '#f7fff9';
      wardrobeStatusEl.style.color = isError ? '#bd3155' : '#3f6f4d';
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function currentWardrobeColor() {
      const color = colors[currentIndex] || {};
      return {
        name: color.name || urlName || 'Color',
        hex: normalizeHex(color.hex || `#${urlHex}`),
        paletteCode
      };
    }

    function addWardrobeColor(color) {
      const hex = normalizeHex(color.hex || color.hexCode);
      const name = String(color.name || color.colorName || '').trim() || hex;
      if (!hex) return;
      const exists = wardrobeState.selectedColors.some((item) =>
        normalizeHex(item.hex) === hex && String(item.name || '').trim().toLowerCase() === name.toLowerCase()
      );
      if (!exists) {
        wardrobeState.selectedColors.push({ name, hex, paletteCode: color.paletteCode || paletteCode });
      }
    }

    async function loadWardrobesForColor() {
      if (!wardrobeApiBase || !CUSTOMER_ID) return [];
      const query = new URLSearchParams({ customerId: CUSTOMER_ID });
      const response = await fetch(wardrobeApiBase + '?' + query.toString(), { credentials: 'same-origin' });
      const json = await response.json();
      if (!response.ok) throw new Error(json.error || 'Could not load wardrobes');
      wardrobeState.wardrobes = json.wardrobes || [];
      return wardrobeState.wardrobes;
    }

    function renderWardrobeColorPills() {
      const list = document.getElementById('ycs-wardrobe-selected-colors');
      if (!list) return;
      list.innerHTML = wardrobeState.selectedColors.map((color, index) => `
        <span class="ycs-wardrobe-color-pill">
          <span class="ycs-wardrobe-color-pill__swatch" style="background:${escapeHtml(color.hex)}"></span>
          ${escapeHtml(color.name)}
          <button type="button" data-ycs-wardrobe-remove-color="${index}" aria-label="Remove color">×</button>
        </span>
      `).join('');
    }

    function renderPaletteSwatches() {
      const swatches = document.getElementById('ycs-wardrobe-palette-swatches');
      if (!swatches) return;

      swatches.innerHTML = colors
        .map((color, index) => ({ color, index }))
        .filter(({ color }) => normalizeHex(color.hex))
        .map(({ color, index }) => {
          const hex = normalizeHex(color.hex);
          const name = color.name || hex;
          const selected = wardrobeState.selectedColors.some((item) => normalizeHex(item.hex) === hex);
          return `
            <button
              type="button"
              class="ycs-wardrobe-swatch-option${selected ? ' is-selected' : ''}"
              data-ycs-wardrobe-color-option="${index}"
              title="${escapeHtml(name)}">
              <span class="ycs-wardrobe-swatch-option__chip" style="background:${escapeHtml(hex)}"></span>
              <span class="ycs-wardrobe-swatch-option__name">${escapeHtml(name)}</span>
            </button>
          `;
        })
        .join('');
    }

    function renderWardrobeForm() {
      if (!wardrobeBodyEl) return;
      const wardrobeOptions = wardrobeState.wardrobes.map((wardrobe) =>
        `<option value="${escapeHtml(wardrobe.id)}">${escapeHtml(wardrobe.name)}</option>`
      ).join('');
      wardrobeBodyEl.innerHTML = `
        <form class="ycs-wardrobe-form" id="ycs-wardrobe-form">
          <div class="ycs-wardrobe-form__row">
            <label>Wardrobe
              <select name="wardrobeId">
                ${wardrobeOptions}
              </select>
            </label>
            <label>New wardrobe
              <input name="newWardrobeName" placeholder="Travel Capsule">
            </label>
          </div>
          <div class="ycs-wardrobe-form__row">
            <label>Item Type
              <select name="itemType">
                <option value="top">Top</option>
                <option value="bottom">Bottom</option>
                <option value="dress_jumpsuit">Dress / Jumpsuit</option>
                <option value="outer_layer">Outer Layer</option>
                <option value="shoe">Shoe</option>
                <option value="bag">Bag</option>
              </select>
            </label>
            <label>Description
              <input name="description" placeholder="Silk Blouse" required>
            </label>
          </div>
          <div>
            <label>Colors</label>
            <div class="ycs-wardrobe-selected-colors" id="ycs-wardrobe-selected-colors"></div>
          </div>
          <div>
            <label>Add another palette color</label>
            <div class="ycs-wardrobe-palette-swatches" id="ycs-wardrobe-palette-swatches"></div>
          </div>
          <div class="ycs-wardrobe-form__actions">
            <button type="submit" class="ycs-color-combos-btn ycs-wardrobe-primary-action">Add Item</button>
          </div>
        </form>
      `;
      renderWardrobeColorPills();
      renderPaletteSwatches();
    }

    async function openWardrobeDrawer() {
      if (!wardrobeDrawer || !accessIsAdmin) return;
      wardrobeState.selectedColors = [];
      addWardrobeColor(currentWardrobeColor());
      wardrobeDrawer.classList.add('is-open');
      wardrobeDrawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      setWardrobeStatus('Loading wardrobes...', false);
      try {
        await loadWardrobesForColor();
        setWardrobeStatus('', false);
        renderWardrobeForm();
      } catch (error) {
        console.error(error);
        setWardrobeStatus(error.message || 'Could not load wardrobes.', true);
        renderWardrobeForm();
      }
    }

    function closeWardrobeDrawer() {
      if (!wardrobeDrawer) return;
      wardrobeDrawer.classList.remove('is-open');
      wardrobeDrawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = 'hidden';
    }

    async function saveWardrobeItem(form) {
      if (!wardrobeApiBase || !CUSTOMER_ID) return;
      let wardrobeId = String(form.elements.wardrobeId?.value || '').trim();
      const newWardrobeName = String(form.elements.newWardrobeName?.value || '').trim();
      const description = String(form.elements.description?.value || '').trim();
      const itemType = String(form.elements.itemType?.value || '').trim();

      if (!description) throw new Error('Description is required');
      if (!wardrobeState.selectedColors.length) throw new Error('Select at least one color');

      if (newWardrobeName) {
        const createResponse = await fetch(wardrobeApiBase, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ customerId: CUSTOMER_ID, action: 'createWardrobe', name: newWardrobeName })
        });
        const createJson = await createResponse.json();
        if (!createResponse.ok) throw new Error(createJson.error || 'Could not create wardrobe');
        wardrobeId = createJson.wardrobe?.id || wardrobeId;
      }

      if (!wardrobeId) throw new Error('Choose or create a wardrobe');

      const response = await fetch(wardrobeApiBase, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          customerId: CUSTOMER_ID,
          action: 'createItem',
          wardrobeId,
          description,
          itemType,
          colors: wardrobeState.selectedColors
        })
      });
      const json = await response.json();
      if (!response.ok) throw new Error(json.error || 'Could not add item');
    }

    const TONAL_ADJACENCY_MAP = {
      Reds: ['Oranges', 'Pinks'],
      Oranges: ['Reds', 'Golden Yellows'],
      'Golden Yellows': ['Oranges', 'Yellows'],
      Yellows: ['Golden Yellows', 'Yellow Greens'],
      'Yellow Greens': ['Yellows', 'Greens'],
      Greens: ['Yellow Greens', 'Aquas/Teals'],
      'Aquas/Teals': ['Greens', 'Blues'],
      Blues: ['Aquas/Teals', 'Indigos'],
      Indigos: ['Blues', 'Purples'],
      Purples: ['Indigos', 'Plums'],
      Plums: ['Purples', 'Magentas'],
      Magentas: ['Plums', 'Pinks'],
      Pinks: ['Magentas', 'Reds']
    };

    const BOLD_CONTRAST_MAP = {
      Reds: ['Aquas/Teals', 'Plums', 'Blues'],
      Oranges: ['Blues', 'Aquas/Teals', 'Indigos'],
      'Golden Yellows': ['Purples', 'Indigos', 'Blues'],
      Yellows: ['Blues', 'Aquas/Teals', 'Purples', 'Plums'],
      'Yellow Greens': ['Indigos', 'Magentas', 'Purples'],
      Greens: ['Pinks', 'Plums', 'Purples'],
      'Aquas/Teals': ['Oranges', 'Reds', 'Magentas', 'Pinks'],
      Blues: ['Oranges', 'Reds', 'Golden Yellows', 'Pinks'],
      Indigos: ['Yellow Greens', 'Yellows', 'Golden Yellows', 'Oranges', 'Reds'],
      Purples: ['Golden Yellows', 'Yellows', 'Yellow Greens', 'Greens'],
      Plums: ['Reds', 'Greens', 'Yellows', 'Aquas/Teals'],
      Magentas: ['Yellow Greens', 'Greens', 'Aquas/Teals'],
      Pinks: ['Greens', 'Aquas/Teals', 'Blues', 'Reds']
    };

    function normalizeHex(hex) {
      const value = String(hex || '').trim();
      return value.startsWith('#') ? value.toLowerCase() : `#${value.toLowerCase()}`;
    }

    function normalizeValue(value) {
      return String(value || '').trim().toLowerCase();
    }

    function parsePaletteCodes(value) {
      if (Array.isArray(value)) return value.map(v => String(v).trim().toUpperCase()).filter(Boolean);
      return String(value || '').split(',').map(v => v.trim().toUpperCase()).filter(Boolean);
    }

    function toBoolean(value) {
      if (typeof value === 'boolean') return value;
      const normalized = normalizeValue(value);
      return normalized === 'true' || normalized === '1' || normalized === 'yes';
    }

    function sortByOrder(items) {
      return items.slice().sort((a, b) => Number(a.sortOrder || 9999) - Number(b.sortOrder || 9999));
    }

    function uniqueByHex(items) {
      const seen = new Set();
      return items.filter(item => {
        const key = normalizeHex(item.hex);
        if (!key || seen.has(key)) return false;
        seen.add(key);
        return true;
      });
    }

    function belongsToPalette(color, activePaletteCode) {
      const codes = parsePaletteCodes(color.paletteCodes);
      return codes.includes(String(activePaletteCode || '').toUpperCase());
    }

    function getDepthRank(depth) {
      const normalized = normalizeValue(depth);
      if (normalized === 'light') return 1;
      if (normalized === 'medium') return 2;
      if (normalized === 'deep' || normalized === 'dark') return 3;
      return 999;
    }

    function getNeutralDepthValue(color) {
      return normalizeValue(color?.neutralDepth || color?.depth || '');
    }

    function filterNeutralsWithDifferentDepth(items, firstNeutral) {
      if (!firstNeutral) return items || [];
      const firstDepth = getNeutralDepthValue(firstNeutral);
      return (items || []).filter(item => getNeutralDepthValue(item) !== firstDepth);
    }

    function findNearestBySortOrder(items, selectedColor) {
      const selectedOrder = Number(selectedColor.sortOrder || 0);
      return items
        .filter(item => normalizeHex(item.hex) !== normalizeHex(selectedColor.hex))
        .sort((a, b) => {
          const aDiff = Math.abs(Number(a.sortOrder || 0) - selectedOrder);
          const bDiff = Math.abs(Number(b.sortOrder || 0) - selectedOrder);
          return aDiff - bDiff;
        })[0] || null;
    }

    function pickFromPoolAlternating(items, ratio, step = 0) {
      if (!items || !items.length) return null;
      const sorted = sortByOrder(items);
      const maxIndex = sorted.length - 1;
      const baseIndex = Math.round(ratio * maxIndex);
      const offsets = [0, 1, -1, 2, -2, 3, -3];

      for (const offset of offsets) {
        const targetIndex = baseIndex + offset + step;
        if (targetIndex >= 0 && targetIndex <= maxIndex) {
          return sorted[targetIndex];
        }
      }

      return sorted[Math.max(0, Math.min(maxIndex, baseIndex))] || null;
    }

    function pickWithVariant(items, ratio, step = 0) {
      return pickFromPoolAlternating(items, ratio, step + comboVariantIndex);
    }

    function getCategoryPositionInfo(selectedColor, sameCategoryColors) {
      const sorted = sortByOrder(
        sameCategoryColors
          .filter(c => normalizeHex(c.hex) !== normalizeHex(selectedColor.hex))
          .concat([selectedColor])
      );
      const index = sorted.findIndex(c => normalizeHex(c.hex) === normalizeHex(selectedColor.hex));
      const count = sorted.length;

      if (index === -1 || count <= 1) return { index: 0, count, ratio: 0 };

      return {
        index,
        count,
        ratio: index / (count - 1)
      };
    }

    function isCCD(activePaletteCode) {
      return activePaletteCode === 'CCD';
    }

    function isRestrictedEasyPalette(activePaletteCode) {
      return ['CWL','CWM','SWL','SWM','SWD','LO','MO','DO','SCL','SCM','CCL','CCM'].includes(activePaletteCode);
    }

    function isSameDepth(a, b) {
      return getDepthRank(a) === getDepthRank(b);
    }

    function isAdjacentDepth(a, b) {
      return Math.abs(getDepthRank(a) - getDepthRank(b)) === 1;
    }

    function isLightDeepPair(a, b) {
      const r1 = getDepthRank(a);
      const r2 = getDepthRank(b);
      return (r1 === 1 && r2 === 3) || (r1 === 3 && r2 === 1);
    }

    function isAllowedTonalDepthPair(selectedDepth, candidateDepth, activePaletteCode) {
      if (!selectedDepth || !candidateDepth) return false;
      if (isCCD(activePaletteCode)) {
        return isAdjacentDepth(selectedDepth, candidateDepth) || isLightDeepPair(selectedDepth, candidateDepth);
      }
      return isAdjacentDepth(selectedDepth, candidateDepth);
    }

    function isAllowedContrastDepthPair(selectedDepth, candidateDepth) {
      if (!selectedDepth || !candidateDepth) return false;
      return !isSameDepth(selectedDepth, candidateDepth);
    }

    function setFavoriteButtonState(isFavorite) {
      if (!favoriteBtn) return;
      favoriteBtn.classList.toggle('is-favorite', isFavorite);
      favoriteBtn.setAttribute('aria-label', isFavorite ? 'Remove from favorites' : 'Add to favorites');
      favoriteBtn.setAttribute('title', isFavorite ? 'Remove from favorites' : 'Add to favorites');
      if (favoriteLabel) favoriteLabel.textContent = isFavorite ? 'Favorited' : 'Favorite';
    }

    function updateFavoriteButtonForCurrentColor() {
      if (!favoriteBtn) return;
      const color = colors[currentIndex];
      if (!color) return;
      const isFavorite = favoriteHexes.has(normalizeHex(color.hex));
      setFavoriteButtonState(isFavorite);
    }
if (favoriteBtn) {
  favoriteBtn.classList.add('is-loading');

  setTimeout(() => {
    favoriteBtn.classList.remove('is-loading');
  }, 300);
}

    function comboCardMarkup(combo, isLocked) {
      return `
        <article class="ycs-combo-card${isLocked ? ' ycs-combo-card--locked' : ''}">
          <div class="ycs-combo-card__content">
            <p class="ycs-combo-card__label">${combo.label}</p>
            <div class="ycs-combo-card__swatches">
              ${combo.colors.map(color => `
                <div
                  class="ycs-combo-card__swatch"
                  data-hex="${normalizeHex(color.hex)}"
                  data-name="${String(color.name || '').replace(/"/g, '&quot;')}"
                  title="View ${color.name}"
                  style="background:${normalizeHex(color.hex)};">
                </div>
              `).join('')}
            </div>
            <p class="ycs-combo-card__names">
              ${combo.colors.map(color => color.name).join(' + ')}
            </p>
            <div class="ycs-combo-card__footer"></div>
          </div>
          ${isLocked ? `
            <div class="ycs-combo-card__lock-overlay">
              <div class="ycs-combo-card__lock-inner">
                <p class="ycs-combo-card__lock-title">Unlock more color combos</p>
                <p class="ycs-combo-card__lock-text">
                  Unlock personalized color combinations inside Style Masters.
                </p>
                <button class="ycs-combo-card__lock-button" data-open-upsell type="button">
                  Unlock My Color Combos
                </button>
              </div>
            </div>
          ` : ''}
        </article>
      `;
    }

    function generateColorCombos(selectedColor, allColors, activePaletteCode) {
      const paletteColors = allColors.filter(color => belongsToPalette(color, activePaletteCode));
      const selectedHex = normalizeHex(selectedColor.hex);
      const selectedDepth = normalizeValue(selectedColor.depth);
      const samePalette = paletteColors.filter(color => normalizeHex(color.hex) !== selectedHex);

      const neutrals = samePalette.filter(color => toBoolean(color.isNeutral));
      const lightNeutrals = neutrals.filter(color => normalizeValue(color.neutralDepth) === 'light');
      const mediumNeutrals = neutrals.filter(color => normalizeValue(color.neutralDepth) === 'medium');
      const deepNeutrals = neutrals.filter(color => {
        const depth = normalizeValue(color.neutralDepth);
        return depth === 'deep' || depth === 'dark';
      });

      const sameCategory = samePalette.filter(color =>
        !toBoolean(color.isNeutral) &&
        normalizeValue(color.category) === normalizeValue(selectedColor.category)
      );

      const categoryPosition = getCategoryPositionInfo(selectedColor, sameCategory);
      const categoryRatio = categoryPosition.ratio;

      const sameDepthNeutrals = neutrals.filter(n => normalizeValue(n.neutralDepth) === selectedDepth);
      const lighterNeutrals = neutrals.filter(n => getDepthRank(n.neutralDepth) < getDepthRank(selectedDepth));
      const deeperNeutrals = neutrals.filter(n => getDepthRank(n.neutralDepth) > getDepthRank(selectedDepth));

      let easyNeutral1 = null;
      let easyNeutral2 = null;

      if (isCCD(activePaletteCode)) {
        easyNeutral1 =
          pickWithVariant(lightNeutrals, categoryRatio, 0) ||
          pickWithVariant(mediumNeutrals, categoryRatio, 0) ||
          pickWithVariant(neutrals, categoryRatio, 0);

        easyNeutral2 =
          pickWithVariant(filterNeutralsWithDifferentDepth(deepNeutrals, easyNeutral1), categoryRatio, 0) ||
          pickWithVariant(filterNeutralsWithDifferentDepth(mediumNeutrals, easyNeutral1), categoryRatio, 1) ||
          pickWithVariant(filterNeutralsWithDifferentDepth(lightNeutrals, easyNeutral1), categoryRatio, 1) ||
          pickWithVariant(filterNeutralsWithDifferentDepth(neutrals, easyNeutral1), categoryRatio, 1);
      } else if (isRestrictedEasyPalette(activePaletteCode)) {
        easyNeutral1 =
          pickWithVariant(sameDepthNeutrals, categoryRatio, 0) ||
          pickWithVariant(lighterNeutrals, categoryRatio, 0) ||
          pickWithVariant(deeperNeutrals, categoryRatio, 0) ||
          pickWithVariant(neutrals, categoryRatio, 0);

        easyNeutral2 =
          pickWithVariant(filterNeutralsWithDifferentDepth(lighterNeutrals, easyNeutral1), categoryRatio, 1) ||
          pickWithVariant(filterNeutralsWithDifferentDepth(deeperNeutrals, easyNeutral1), categoryRatio, 1) ||
          pickWithVariant(filterNeutralsWithDifferentDepth(sameDepthNeutrals, easyNeutral1), categoryRatio, 1) ||
          pickWithVariant(filterNeutralsWithDifferentDepth(neutrals, easyNeutral1), categoryRatio, 1);
      } else {
        easyNeutral1 = pickWithVariant(neutrals, categoryRatio, 0);
        easyNeutral2 =
          pickWithVariant(filterNeutralsWithDifferentDepth(neutrals, easyNeutral1), categoryRatio, 1) ||
          pickWithVariant(neutrals, categoryRatio, 1);
      }

      const tonalAllowedCategories = new Set([
        selectedColor.category,
        ...(TONAL_ADJACENCY_MAP[selectedColor.category] || [])
      ]);

      const tonalPool = samePalette.filter(color =>
        !toBoolean(color.isNeutral) &&
        tonalAllowedCategories.has(color.category)
      );

      const tonalDepthFiltered = tonalPool.filter(color =>
        isAllowedTonalDepthPair(selectedColor.depth, color.depth, activePaletteCode)
      );

      const tonalPartner =
        pickWithVariant(tonalDepthFiltered, categoryRatio, 0) ||
        pickWithVariant(tonalDepthFiltered, categoryRatio, 1) ||
        findNearestBySortOrder(tonalDepthFiltered, selectedColor) ||
        pickWithVariant(tonalPool, categoryRatio, 0) ||
        findNearestBySortOrder(tonalPool, selectedColor);

      const tonalNeutral =
        pickWithVariant(
          neutrals.filter(n => normalizeValue(n.neutralDepth) === selectedDepth),
          categoryRatio,
          0
        ) ||
        (isCCD(activePaletteCode) ? pickWithVariant(neutrals, categoryRatio, 0) : null) ||
        pickWithVariant(mediumNeutrals, categoryRatio, 0) ||
        pickWithVariant(neutrals, categoryRatio, 0);

      const contrastAllowedCategories = BOLD_CONTRAST_MAP[selectedColor.category] || [];

      const contrastPool = samePalette.filter(color =>
        !toBoolean(color.isNeutral) &&
        contrastAllowedCategories.includes(color.category)
      );

      const contrastDepthFiltered = contrastPool.filter(color =>
        isAllowedContrastDepthPair(selectedColor.depth, color.depth)
      );

      const contrastPartner =
        pickWithVariant(contrastDepthFiltered, categoryRatio, 0) ||
        pickWithVariant(contrastDepthFiltered, categoryRatio, 1) ||
        pickWithVariant(contrastDepthFiltered, categoryRatio, -1) ||
        findNearestBySortOrder(contrastDepthFiltered, selectedColor) ||
        pickWithVariant(contrastPool, categoryRatio, 0) ||
        findNearestBySortOrder(contrastPool, selectedColor);

      const contrastNeutral =
        pickWithVariant(neutrals, categoryRatio, 0) ||
        pickWithVariant(mediumNeutrals, categoryRatio, 0);

      const isMember = canAccess('color_combos');

      const combos = [
        {
          id: 'easy',
          label: isMember ? 'Easy Outfit' : 'Your Starter Combo',
          colors: uniqueByHex([selectedColor, easyNeutral1, easyNeutral2].filter(Boolean))
        },
        {
          id: 'tonal',
          label: isMember ? 'Polished Tonal' : 'Next Level Combo',
          colors: uniqueByHex([selectedColor, tonalPartner, tonalNeutral].filter(Boolean))
        },
        {
          id: 'contrast',
          label: isMember ? 'Bold Contrast' : 'High Impact Combo',
          colors: uniqueByHex([selectedColor, contrastPartner, contrastNeutral].filter(Boolean))
        }
      ];

      return combos.filter(combo => combo.colors.length >= 2);
    }

    function openDrawer() {
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = 'hidden';
    }

    function renderColorCombos() {
      if (comboHint) {
        comboHint.style.display = canAccess('color_combos') ? 'none' : '';
      }

      if (!combosGrid || !openCombosBtn) return;

      const selectedColor = colors[currentIndex];

      if (!selectedColor || !paletteCode) {
        openCombosBtn.style.display = 'none';
        combosGrid.innerHTML = '';
        return;
      }

      const combos = generateColorCombos(selectedColor, colors, paletteCode);

      if (!combos.length) {
        openCombosBtn.style.display = 'none';
        combosGrid.innerHTML = '';
        return;
      }

      combosGrid.innerHTML = combos.map((combo, index) => {
        const isLocked = !canAccess('color_combos') && index > 0;
        return comboCardMarkup(combo, isLocked);
      }).join('');

      openCombosBtn.style.display = '';
    }
    function updatePhotoStudioLink(color) {
  if (!openPhotoStudioBtn || !color) return;

  const hex = normalizeHex(color.hex);
  const name = color.name || 'Color';
  const returnUrl = window.location.pathname + window.location.search;

  const params = new URLSearchParams();

  if (paletteCode) params.set('palette', paletteCode);
  if (hex) params.set('hex', hex);
  if (name) params.set('colorName', name);
  if (returnUrl) params.set('returnUrl', returnUrl);

  const baseUrl = hasPaidDrapingAccess
  ? '/pages/my-photos?mode=personal'
  : '/pages/my-photos?mode=personal&trial=sample';

photoStudioUrl = `${baseUrl}&${params.toString()}`;
}

    function applyColor(pushUrl) {
  const color = colors[currentIndex];
  if (!color) return;

  updatePhotoStudioLink(color);

      const hex = normalizeHex(color.hex);
      const name = color.name || 'Color';

      page.style.background = hex;
      nameEl.textContent = name;
      comboVariantIndex = 0;
      renderColorCombos();

      sessionStorage.setItem('ycsPaletteIndex', String(currentIndex));

      const nextUrl = paletteCode
        ? `/pages/member-color?hex=${encodeURIComponent(hex.replace('#', ''))}&name=${encodeURIComponent(name)}&palette=${encodeURIComponent(paletteCode)}`
        : `/pages/member-color?hex=${encodeURIComponent(hex.replace('#', ''))}&name=${encodeURIComponent(name)}`;

      if (pushUrl) {
        window.history.pushState({ index: currentIndex }, '', nextUrl);
      } else {
        window.history.replaceState({ index: currentIndex }, '', nextUrl);
      }

      if (colors.length <= 1) {
        prevBtn.style.display = 'none';
        nextBtn.style.display = 'none';
      } else {
        prevBtn.style.display = '';
        nextBtn.style.display = '';
      }

      updateFavoriteButtonForCurrentColor();
    }

    function showNextColor() {
      if (colors.length <= 1) return;
      currentIndex = (currentIndex + 1) % colors.length;
      applyColor(true);
    }

    function showPrevColor() {
      if (colors.length <= 1) return;
      currentIndex = (currentIndex - 1 + colors.length) % colors.length;
      applyColor(true);
    }
// FAVORITES
// Uses /apps/palette-data with action=getFavorites and action=toggleFavorite
// Do not change this unless the backend route is changed too
    async function loadFavorites() {
      if (!CUSTOMER_ID || !paletteCode) return;

      try {
        const response = await fetch(
          `/apps/palette-data?action=getFavorites&customerId=${encodeURIComponent(CUSTOMER_ID)}&palette=${encodeURIComponent(paletteCode)}`,
          { credentials: 'same-origin' }
        );

        const text = await response.text();
        const data = text ? JSON.parse(text) : {};

        if (!response.ok) {
          throw new Error(data.error || 'Could not load favorites');
        }

        favoriteHexes = new Set((data.favorites || []).map(normalizeHex));
        updateFavoriteButtonForCurrentColor();
      } catch (error) {
        console.error('loadFavorites failed:', error);
      }
    }

    async function toggleFavoriteForCurrentColor() {
      if (!favoriteBtn || !CUSTOMER_ID || !paletteCode) return;

      const color = colors[currentIndex];
      if (!color) return;

      const hex = normalizeHex(color.hex);
      const name = color.name || 'Color';
      const wasFavorite = favoriteHexes.has(hex);

      if (wasFavorite) {
        favoriteHexes.delete(hex);
      } else {
        favoriteHexes.add(hex);
      }

      updateFavoriteButtonForCurrentColor();

      try {
        const response = await fetch(`/apps/palette-data?action=toggleFavorite`, {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            customerId: CUSTOMER_ID,
            paletteCode: paletteCode,
            colorName: name,
            hex: hex
          })
        });

        const text = await response.text();
        const result = text ? JSON.parse(text) : {};

        if (!response.ok || !result.success) {
          throw new Error(result.error || 'Failed to update favorite');
        }

        if (result.isFavorite) {
          favoriteHexes.add(hex);
        } else {
          favoriteHexes.delete(hex);
        }

        updateFavoriteButtonForCurrentColor();
      } catch (error) {
        console.error('toggleFavorite failed:', error);

        if (wasFavorite) {
          favoriteHexes.add(hex);
        } else {
          favoriteHexes.delete(hex);
        }

        updateFavoriteButtonForCurrentColor();
      }
    }

    async function loadPaletteColorsForCombos() {
      if (!paletteCode) return;

      try {
        const response = await fetch(`/apps/palette-data?palette=${encodeURIComponent(paletteCode)}`, {
          credentials: 'same-origin'
        });

        const data = await response.json();

        if (!response.ok || !data.colors) {
          throw new Error(data.error || 'Could not load palette colors');
        }

        colors = data.colors.map(color => ({
          name: color.name || color.ColorName || '',
          hex: color.hex || color.Hex || '',
          sortOrder: Number(color.sortOrder || color.SortOrder || 9999),
          category: color.category || color.Category || '',
          paletteCodes: color.paletteCodes || color.palettes || color.PaletteCodes_Final_Manual || '',
          depth: color.depth || color.Depth || '',
          temperature: color.temperature || color.Temperature || '',
          chroma: color.chroma || color.Chroma || '',
          isNeutral: color.isNeutral ?? color.IsNeutral ?? false,
          neutralDepth: color.neutralDepth || color.NeutralDepth || '',
          isBest: color.isBest ?? color.IsBest ?? false
        }));

        const currentHexNormalized = normalizeHex(`#${urlHex}`);
        const matchedIndex = colors.findIndex(color => normalizeHex(color.hex) === currentHexNormalized);

        if (matchedIndex >= 0) {
          currentIndex = matchedIndex;
        } else {
          colors.unshift({
            name: urlName,
            hex: `#${urlHex}`,
            sortOrder: 0,
            category: '',
            paletteCodes: paletteCode,
            depth: '',
            temperature: '',
            chroma: '',
            isNeutral: false,
            neutralDepth: '',
            isBest: false
          });
          currentIndex = 0;
        }

        applyColor(false);
      } catch (error) {
        console.error('Combo palette load failed:', error);
      }
    }

    prevBtn.addEventListener('click', showPrevColor);
    nextBtn.addEventListener('click', showNextColor);

    if (favoriteBtn) {
      favoriteBtn.addEventListener('click', toggleFavoriteForCurrentColor);
    }

    if (openCombosBtn) {
      openCombosBtn.addEventListener('click', openDrawer);
    }

    if (closeCombosBtn) {
      closeCombosBtn.addEventListener('click', closeDrawer);
    }

    if (closeCombosTextBtn) {
      closeCombosTextBtn.addEventListener('click', closeDrawer);
    }

    if (drawerScrim) {
      drawerScrim.addEventListener('click', closeDrawer);
    }

    if (upsellClose) {
      upsellClose.addEventListener('click', closeUpsell);
    }

    if (upsellCloseBtn) {
      upsellCloseBtn.addEventListener('click', closeUpsell);
    }

    if (openWardrobeBtn) {
      openWardrobeBtn.addEventListener('click', openWardrobeDrawer);
    }

    if (closeWardrobeBtn) {
      closeWardrobeBtn.addEventListener('click', closeWardrobeDrawer);
    }

    if (closeWardrobeTextBtn) {
      closeWardrobeTextBtn.addEventListener('click', closeWardrobeDrawer);
    }

    if (wardrobeDrawerScrim) {
      wardrobeDrawerScrim.addEventListener('click', closeWardrobeDrawer);
    }

    if (wardrobeBodyEl) {
      wardrobeBodyEl.addEventListener('click', function (event) {
        const swatchButton = event.target.closest('[data-ycs-wardrobe-color-option]');
        if (swatchButton) {
          const index = Number(swatchButton.dataset.ycsWardrobeColorOption || -1);
          const color = colors[index];
          if (color) {
            addWardrobeColor({ ...color, paletteCode });
            renderWardrobeColorPills();
            renderPaletteSwatches();
          }
          return;
        }

        const removeButton = event.target.closest('[data-ycs-wardrobe-remove-color]');
        if (removeButton) {
          wardrobeState.selectedColors.splice(Number(removeButton.dataset.ycsWardrobeRemoveColor), 1);
          renderWardrobeColorPills();
          renderPaletteSwatches();
        }
      });

      wardrobeBodyEl.addEventListener('submit', async function (event) {
        const form = event.target.closest('#ycs-wardrobe-form');
        if (!form) return;
        event.preventDefault();
        setWardrobeStatus('Adding item...', false);
        try {
          await saveWardrobeItem(form);
          setWardrobeStatus('Added to wardrobe.', false);
          window.setTimeout(closeWardrobeDrawer, 550);
        } catch (error) {
          console.error(error);
          setWardrobeStatus(error.message || 'Could not add item.', true);
        }
      });
    }

    if (shuffleBtn) {
      shuffleBtn.addEventListener('click', function () {
        comboVariantIndex += 1;
        renderColorCombos();
      });
    }

    document.addEventListener('click', function (e) {
      const trigger = e.target.closest('[data-open-upsell]');
      if (trigger) {
        openUpsell();
      }
    });

    combosGrid.addEventListener('click', function (e) {
      const swatch = e.target.closest('.ycs-combo-card__swatch');
      if (swatch) {
        const hex = (swatch.dataset.hex || '').replace('#', '').trim().toUpperCase();
        const name = swatch.dataset.name || '';
        const foundIndex = colors.findIndex(color =>
          normalizeHex(color.hex) === `#${hex.toLowerCase()}` &&
          String(color.name || '') === name
        );

        if (foundIndex >= 0) {
          currentIndex = foundIndex;
          applyColor(true);
          closeDrawer();
        } else {
          const nextUrl = paletteCode
            ? `/pages/member-color?hex=${encodeURIComponent(hex)}&name=${encodeURIComponent(name)}&palette=${encodeURIComponent(paletteCode)}`
            : `/pages/member-color?hex=${encodeURIComponent(hex)}&name=${encodeURIComponent(name)}`;

          window.location.href = nextUrl;
        }
      }
    });

    closeBtn.addEventListener('click', function () {
      const returnUrl = sessionStorage.getItem('ycsPaletteReturnUrl');

      if (document.referrer && document.referrer.includes('/pages/member-color')) {
        window.history.back();
      } else if (returnUrl) {
        window.location.href = returnUrl;
      } else {
        window.location.href = '/pages/ycs-color-palettes';
      }
    });
    if (openPhotoStudioBtn) {
  openPhotoStudioBtn.addEventListener('click', function () {
    if (!photoStudioUrl) return;
    window.location.href = photoStudioUrl;
  });
}
    page.addEventListener('touchstart', function (e) {
      const touch = e.changedTouches[0];
      startX = touch.clientX;
      startY = touch.clientY;
    }, { passive: true });

    page.addEventListener('touchend', function (e) {
      if (drawer.classList.contains('is-open')) return;

      const touch = e.changedTouches[0];
      const endX = touch.clientX;
      const endY = touch.clientY;

      const diffX = endX - startX;
      const diffY = endY - startY;

      if (Math.abs(diffX) < 50) return;
      if (Math.abs(diffX) <= Math.abs(diffY)) return;

      if (diffX < 0) {
        showNextColor();
      } else {
        showPrevColor();
      }
    }, { passive: true });

    window.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeDrawer();
      }
      if (e.key === 'Escape' && upsellModal && upsellModal.classList.contains('is-open')) {
        closeUpsell();
      }
      if (e.key === 'Escape' && wardrobeDrawer && wardrobeDrawer.classList.contains('is-open')) {
        closeWardrobeDrawer();
      }
    });

    window.addEventListener('popstate', function () {
      const popParams = new URLSearchParams(window.location.search);
      const popHex = (popParams.get('hex') || '').replace('#', '').trim().toUpperCase();
      const popName = popParams.get('name') || '';

      const foundIndex = colors.findIndex(color => {
        const colorHex = String(color.hex || '').replace('#', '').trim().toUpperCase();
        const colorName = String(color.name || '');
        return colorHex === popHex && colorName === popName;
      });

      if (foundIndex >= 0) {
        currentIndex = foundIndex;
        applyColor(false);
      }
    });

    applyColor(false);
    await loadFavorites();
    await loadPaletteColorsForCombos();
  });
</script>
