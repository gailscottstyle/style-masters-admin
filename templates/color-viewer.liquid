{% assign palette_access_string = '' %}

{% if customer %}
  {% assign palette_access_string = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
{% endif %}
{% assign is_ycs_member = false %}
{% if customer and palette_access_string contains ',YCSMEMBER,' or customer and palette_access_string contains ',TRADE,' %}
  {% assign is_ycs_member = true %}
{% endif %}
{% assign is_color_viewer_admin = false %}
{% if palette_access_string contains ',YCS_ADMIN,' %}
  {% assign is_color_viewer_admin = true %}
{% endif %}
{% assign is_trade_july_cohort = false %}
{% assign trade_july_cohort_expires_at = '2026-08-25 00:00:00 -0400' | date: '%s' %}
{% assign trade_sept_cohort_expires_at = '2026-10-20 00:00:00 -0400' | date: '%s' %}
{% assign current_timestamp = 'now' | date: '%s' %}
{% if palette_access_string contains ',TRADEJULYCOHORT,' and current_timestamp < trade_july_cohort_expires_at %}
  {% assign is_trade_july_cohort = true %}
{% endif %}
{% assign is_trade_sept_cohort = false %}
{% if palette_access_string contains ',TRADESEPTCOHORT,' and current_timestamp < trade_sept_cohort_expires_at %}
  {% assign is_trade_sept_cohort = true %}
{% endif %}

{% assign is_guided_tool = false %}
{% assign is_guided_training = false %}
{% if customer and palette_access_string contains ',GUIDED,' %}
  {% for ycs_customer_tag in customer.tags %}
    {% assign ycs_guided_tag = ycs_customer_tag | upcase | strip %}
    {% if ycs_guided_tag contains 'GUIDED_TOOL_EXPIRES_' %}
      {% assign ycs_guided_tool_raw = ycs_guided_tag | remove: 'GUIDED_TOOL_EXPIRES_' %}
      {% if ycs_guided_tool_raw.size == 8 %}
        {% assign ycs_guided_tool_year = ycs_guided_tool_raw | slice: 0, 4 %}
        {% assign ycs_guided_tool_month = ycs_guided_tool_raw | slice: 4, 2 %}
        {% assign ycs_guided_tool_day = ycs_guided_tool_raw | slice: 6, 2 %}
        {% assign ycs_guided_tool_expires_at = ycs_guided_tool_year | append: '-' | append: ycs_guided_tool_month | append: '-' | append: ycs_guided_tool_day | append: ' 23:59:59 -0400' | date: '%s' %}
        {% if current_timestamp <= ycs_guided_tool_expires_at %}
          {% assign is_guided_tool = true %}
        {% endif %}
      {% endif %}
    {% endif %}
    {% if ycs_guided_tag contains 'GUIDED_TRAINING_EXPIRES_' %}
      {% assign ycs_guided_training_raw = ycs_guided_tag | remove: 'GUIDED_TRAINING_EXPIRES_' %}
      {% if ycs_guided_training_raw.size == 8 %}
        {% assign ycs_guided_training_year = ycs_guided_training_raw | slice: 0, 4 %}
        {% assign ycs_guided_training_month = ycs_guided_training_raw | slice: 4, 2 %}
        {% assign ycs_guided_training_day = ycs_guided_training_raw | slice: 6, 2 %}
        {% assign ycs_guided_training_expires_at = ycs_guided_training_year | append: '-' | append: ycs_guided_training_month | append: '-' | append: ycs_guided_training_day | append: ' 23:59:59 -0400' | date: '%s' %}
        {% if current_timestamp <= ycs_guided_training_expires_at %}
          {% assign is_guided_training = true %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}
{% assign has_color_analysis_tools_access = false %}
{% if palette_access_string contains ',YCS_ADMIN,' or palette_access_string contains ',TRADE,' or palette_access_string contains ',CATOOL,' or palette_access_string contains ',YCSPRO,' or palette_access_string contains ',DIYCATOOL,' or palette_access_string contains ',FREEDIYCATOOL,' %}
  {% assign has_color_analysis_tools_access = true %}
{% endif %}
{% if is_trade_july_cohort %}
  {% assign has_color_analysis_tools_access = true %}
{% endif %}
{% if is_trade_sept_cohort %}
  {% assign has_color_analysis_tools_access = true %}
{% endif %}
{% if is_guided_tool %}
  {% assign has_color_analysis_tools_access = true %}
{% endif %}
{% if is_ycs_member %}
  {% assign has_color_analysis_tools_access = true %}
{% endif %}

{% if customer == nil %}
  <div class="ycs-member-color-access">
    <p class="ycs-member-color-access__kicker">Your Color Style</p>
    <h1>Sign in to view this color</h1>
    <a href="{{ routes.account_login_url }}">Sign In</a>
  </div>
{% elsif is_ycs_member == false %}
  <div class="ycs-member-color-access">
    <p class="ycs-member-color-access__kicker">Your Color Style</p>
    <h1>Professional Membership Required</h1>
    <p>This feature is included with YCS Professional Membership, designed for color analysts who work with clients. Explore the professional tools and benefits to see if membership is right for you.</p>
    <a href="/#membership">Explore Professional Membership</a>
  </div>
{% else %}
<!-- LIVE COLOR VIEWER -->
<div
  class="ycs-color-page"
  id="ycs-color-page"
  data-customer-id="{{ customer.id }}"
  data-customer-email="{{ customer.email | escape }}"
  data-palette-access="{{ palette_access_string | escape }}"
  data-is-admin="{% if palette_access_string contains ',YCS_ADMIN,' %}true{% else %}false{% endif %}"
  data-is-style-masters="{% if palette_access_string contains ',VIP,' %}true{% else %}false{% endif %}"
  data-app-base-url=""
>
  <nav class="ycs-color-page__nav" aria-label="Palette navigation">

    <a href="/">Dashboard</a>
    <a href="/pages/ycs-color-palettes">YCS Color Palettes</a>
  </nav>

  <button type="button" class="ycs-color-close" id="ycs-color-close" aria-label="Close">✕</button>

  <button type="button" class="ycs-color-arrow ycs-color-arrow--left" id="ycs-color-prev" aria-label="Previous color">
    ‹
  </button>

  <button type="button" class="ycs-color-arrow ycs-color-arrow--right" id="ycs-color-next" aria-label="Next color">
    ›
  </button>

  <section class="ycs-color-dock" id="ycs-color-dock">
    <div class="ycs-color-dock__inner">
      <div class="ycs-color-dock__left">
        <div class="ycs-color-title-row">
          <div class="ycs-color-name" id="ycs-color-name">Color</div>

          {% if customer %}
            <button
              type="button"
              class="ycs-color-fav-btn ycs-color-fav-btn--icon-only"
              id="ycs-color-favorite-btn"
              aria-label="Add to favorites"
              title="Add to favorites">
              <svg class="ycs-color-fav-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 20.2c-.2 0-.4-.1-.6-.2C10.1 19 4 14.7 4 9.6 4 6.9 5.9 5 8.5 5c1.5 0 2.8.7 3.5 1.8C12.7 5.7 14 5 15.5 5 18.1 5 20 6.9 20 9.6c0 5.1-6.1 9.4-7.4 10.4-.2.1-.4.2-.6.2z"></path>
              </svg>
            </button>
          {% endif %}
        </div>
      </div>

      <div class="ycs-color-dock__actions">
        {% if palette_access_string contains ',YCS_ADMIN,' %}
        <button type="button" class="ycs-color-combos-btn" id="ycs-open-wardrobe">
          Add to Wardrobe
        </button>
        {% endif %}
        {% unless has_color_analysis_tools_access %}
          <button type="button" class="ycs-color-combos-btn" id="ycs-open-combos" style="display:none;">
            See Color Combos
          </button>
          <a href="#" class="ycs-color-combos-btn" id="ycs-open-photo-studio">
            Try in Photo Draping Studio
          </a>
        {% endunless %}
      </div>
    </div>
  </section>

  {% if palette_access_string contains ',YCS_ADMIN,' %}
  <section class="ycs-wardrobe-drawer" id="ycs-wardrobe-drawer" aria-hidden="true">
    <div class="ycs-wardrobe-drawer__scrim" id="ycs-wardrobe-drawer-scrim"></div>
    <div class="ycs-wardrobe-drawer__panel">
      <div class="ycs-combo-drawer__handle-wrap">
        <button type="button" class="ycs-combo-drawer__handle" id="ycs-close-wardrobe" aria-label="Close wardrobe drawer"></button>
      </div>
      <div class="ycs-wardrobe-drawer__header">
        <div>
          <h2 class="ycs-combo-drawer__title">Add to Wardrobe</h2>
          <p class="ycs-combo-drawer__subtitle">Create a wardrobe item using this palette color.</p>
        </div>
        <button type="button" class="ycs-combo-drawer__close-btn" id="ycs-close-wardrobe-text">Close</button>
      </div>
      <div class="ycs-wardrobe-drawer__status" id="ycs-wardrobe-status" hidden></div>
      <div class="ycs-wardrobe-drawer__body" id="ycs-wardrobe-body"></div>
    </div>
  </section>
  {% endif %}

  <section class="ycs-combo-drawer" id="ycs-combo-drawer" aria-hidden="true">
    <div class="ycs-combo-drawer__scrim" id="ycs-combo-drawer-scrim"></div>

    <div class="ycs-combo-drawer__panel">
      <div class="ycs-combo-drawer__handle-wrap">
        <button type="button" class="ycs-combo-drawer__handle" id="ycs-close-combos" aria-label="Close color combos"></button>
      </div>

      <div class="ycs-combo-drawer__header">
        <div class="ycs-combo-drawer__copy">
          <h2 class="ycs-combo-drawer__title">Wear This With</h2>
          <p class="ycs-combo-drawer__subtitle">Easy outfit color ideas built around this shade.</p>
        </div>

        <div class="ycs-combo-drawer__actions">
          <button type="button" class="ycs-combo-drawer__shuffle" id="ycs-color-combos-shuffle">
            Show Different Combos
          </button>

          <button type="button" class="ycs-combo-drawer__close-btn" id="ycs-close-combos-text">
            Close
          </button>
        </div>
      </div>

      <div class="ycs-combo-drawer__hint" id="ycs-combo-hint" style="display:none;">
        You have 2 more ways to wear this color ↓
      </div>

      <div class="ycs-combo-drawer__body">
        <div class="ycs-combo-drawer__grid" id="ycs-color-combos-grid"></div>
      </div>
    </div>
  </section>

  <div class="ycs-upsell-modal" id="ycs-upsell-modal" aria-hidden="true">
    <div class="ycs-upsell-modal__scrim" id="ycs-upsell-close"></div>

    <div class="ycs-upsell-modal__panel">
      <button class="ycs-upsell-modal__x" id="ycs-upsell-close-btn" type="button" aria-label="Close">✕</button>

      <p class="ycs-upsell-modal__eyebrow">Your Color Palette</p>

      <h2 class="ycs-upsell-modal__title">
        Get more ways to wear your colors
      </h2>

      <p class="ycs-upsell-modal__text">
        You just saw one outfit idea. Inside Style Masters, you unlock more combinations built around your exact palette.
      </p>

      <ul class="ycs-upsell-modal__list">
        <li>✔ More outfit ideas for every color</li>
        <li>✔ Colors that always work together</li>
        <li>✔ No guesswork getting dressed</li>
      </ul>

      <a href="/palettes" class="ycs-upsell-modal__cta">
        Unlock My Color Combos
      </a>
    </div>
  </div>
</div>
{% endif %}

<style>
