	  .ycs-wardrobe-drawer__panel { position: absolute; left: 50%; bottom: 0; transform: translateX(-50%) translateY(calc(100% - 28px)); width: min(620px, calc(100vw - 24px)); max-height: min(78vh, 760px); background: rgba(245,236,228,0.98); border-radius: 26px 26px 0 0; box-shadow: 0 -10px 34px rgba(0,0,0,0.16); transition: transform .26s ease; display: flex; flex-direction: column; }
	  .ycs-wardrobe-drawer.is-open { pointer-events: auto; }
	  .ycs-wardrobe-drawer.is-open .ycs-wardrobe-drawer__scrim { opacity: 1; }
	  .ycs-wardrobe-drawer.is-open .ycs-wardrobe-drawer__panel { transform: translateX(-50%) translateY(0); }
	  .ycs-wardrobe-drawer__header { display: flex; align-items: start; justify-content: space-between; gap: 16px; padding: 6px 18px 8px; }
	  .ycs-wardrobe-drawer__body { padding: 0 18px 18px; overflow: auto; }
