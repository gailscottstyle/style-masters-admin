  .ycs-color-dock__inner { display: flex; align-items: end; justify-content: space-between; gap: 16px; padding: 18px; border-radius: 28px; background: rgba(245,236,228,0.84); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: 0 18px 42px rgba(0,0,0,0.18); }
