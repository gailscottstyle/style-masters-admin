  .ycs-swatch-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px 6px;
    margin-top: 14px;
  }

  @media (min-width: 700px) {
    .ycs-swatch-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .ycs-palette-section--favorites .ycs-swatch-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px 8px;
    margin-top: 14px;
  }

  .ycs-palette-section--favorites .ycs-swatch-link {
    width: auto;
    min-width: 0;
  }

  .ycs-palette-section--favorites .ycs-swatch-tile {
    border-radius: 16px;
  }

  .ycs-palette-section--favorites .ycs-swatch-name {
    margin-top: 6px;
  }

  @media (min-width: 700px) {
    .ycs-palette-section--favorites .ycs-swatch-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .ycs-swatch-link {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .ycs-swatch-tile {
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.07);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .ycs-swatch-link:hover .ycs-swatch-tile {
    transform: translateY(-3px);
    box-shadow: 0 6px 14px rgba(0,0,0,0.08);
  }

  .ycs-swatch-name {
    margin-top: 2px;
    font-size: 13px;
    line-height: 1.25;
    text-align: center;
    color: #111;
  }

  .ycs-palette-message {
    text-align: center;
    font-size: 14px;
    color: #666;
    margin-top: 18px;
  }

  .ycs-swatch-skeleton {
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    background: linear-gradient(
      90deg,
      #f2f2f2 0%,
      #e8e8e8 50%,
      #f2f2f2 100%
    );
    background-size: 200% 100%;
    animation: ycs-skeleton 1.2s infinite linear;
  }

  @keyframes ycs-skeleton {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }

