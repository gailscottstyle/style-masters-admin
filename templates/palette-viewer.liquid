{% assign palette_access_string = '' %}

{% if customer %}
  {% assign palette_access_string = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
{% endif %}

{% assign is_ycs_member = false %}
{% if customer and palette_access_string contains ',YCSMEMBER,' or customer and palette_access_string contains ',TRADE,' %}
  {% assign is_ycs_member = true %}
{% endif %}

{% assign is_trade_july_cohort = false %}
{% assign trade_july_cohort_expires_at = '2026-08-25 00:00:00 -0400' | date: '%s' %}
{% assign trade_sept_cohort_expires_at = '2026-10-20 00:00:00 -0400' | date: '%s' %}
{% assign current_timestamp = 'now' | date: '%s' %}
{% if palette_access_string contains ',TRADEJULYCOHORT,' and current_timestamp < trade_july_cohort_expires_at %}
  {% assign is_trade_july_cohort = true %}
{% endif %}

{% assign is_trade_sept_cohort = false %}
{% if palette_access_string contains ',TRADESEPTCOHORT,' and current_timestamp < trade_sept_cohort_expires_at %}
  {% assign is_trade_sept_cohort = true %}
{% endif %}

{% assign is_guided_tool = false %}
{% assign is_guided_training = false %}
{% if customer and palette_access_string contains ',GUIDED,' %}
  {% for ycs_customer_tag in customer.tags %}
    {% assign ycs_guided_tag = ycs_customer_tag | upcase | strip %}
    {% if ycs_guided_tag contains 'GUIDED_TOOL_EXPIRES_' %}
      {% assign ycs_guided_tool_raw = ycs_guided_tag | remove: 'GUIDED_TOOL_EXPIRES_' %}
      {% if ycs_guided_tool_raw.size == 8 %}
        {% assign ycs_guided_tool_year = ycs_guided_tool_raw | slice: 0, 4 %}
        {% assign ycs_guided_tool_month = ycs_guided_tool_raw | slice: 4, 2 %}
        {% assign ycs_guided_tool_day = ycs_guided_tool_raw | slice: 6, 2 %}
        {% assign ycs_guided_tool_expires_at = ycs_guided_tool_year | append: '-' | append: ycs_guided_tool_month | append: '-' | append: ycs_guided_tool_day | append: ' 23:59:59 -0400' | date: '%s' %}
        {% if current_timestamp <= ycs_guided_tool_expires_at %}
          {% assign is_guided_tool = true %}
        {% endif %}
      {% endif %}
    {% endif %}
    {% if ycs_guided_tag contains 'GUIDED_TRAINING_EXPIRES_' %}
      {% assign ycs_guided_training_raw = ycs_guided_tag | remove: 'GUIDED_TRAINING_EXPIRES_' %}
      {% if ycs_guided_training_raw.size == 8 %}
        {% assign ycs_guided_training_year = ycs_guided_training_raw | slice: 0, 4 %}
        {% assign ycs_guided_training_month = ycs_guided_training_raw | slice: 4, 2 %}
        {% assign ycs_guided_training_day = ycs_guided_training_raw | slice: 6, 2 %}
        {% assign ycs_guided_training_expires_at = ycs_guided_training_year | append: '-' | append: ycs_guided_training_month | append: '-' | append: ycs_guided_training_day | append: ' 23:59:59 -0400' | date: '%s' %}
        {% if current_timestamp <= ycs_guided_training_expires_at %}
          {% assign is_guided_training = true %}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign has_color_analysis_tools_access = false %}
{% if palette_access_string contains ',YCS_ADMIN,' or palette_access_string contains ',TRADE,' or palette_access_string contains ',CATOOL,' or palette_access_string contains ',YCSPRO,' or palette_access_string contains ',DIYCATOOL,' or palette_access_string contains ',FREEDIYCATOOL,' %}
  {% assign has_color_analysis_tools_access = true %}
{% endif %}
{% if is_trade_july_cohort %}
  {% assign has_color_analysis_tools_access = true %}
{% endif %}
{% if is_trade_sept_cohort %}
  {% assign has_color_analysis_tools_access = true %}
{% endif %}
{% if is_guided_tool %}
  {% assign has_color_analysis_tools_access = true %}
{% endif %}
{% if is_ycs_member %}
  {% assign has_color_analysis_tools_access = true %}
{% endif %}

{% assign is_admin = false %}
{% if palette_access_string contains ',YCS_ADMIN,' %}
  {% assign is_admin = true %}
{% endif %}

{% if customer == nil %}
  <div class="ycs-palette-login">
    <div class="ycs-palette-login__inner">
      <p class="ycs-palette-login__kicker">Your Color Style</p>
      <h1 class="ycs-palette-login__title">Sign in to view your palette</h1>
      <p class="ycs-palette-login__text">
        Please sign in to access your digital color fan.
      </p>
      <a href="{{ routes.account_login_url }}" class="ycs-palette-login__button js-login-return-link">
        Sign In
      </a>
    </div>
  </div>
{% elsif is_ycs_member == false %}
  <div class="ycs-palette-login">
    <div class="ycs-palette-login__inner">
      <p class="ycs-palette-login__kicker">Your Color Style</p>
      <h1 class="ycs-palette-login__title">Professional Membership Required</h1>
      <p class="ycs-palette-login__text">This feature is included with YCS Professional Membership, designed for color analysts who work with clients. Explore the professional tools and benefits to see if membership is right for you.</p>
      <a href="/#membership" class="ycs-palette-login__button">Explore Professional Membership</a>
    </div>
  </div>
{% else %}
  <div
    class="ycs-palette-app"
    data-customer-id="{{ customer.id }}"
    data-customer-email="{{ customer.email | escape }}"
    data-default-palette="{{ section.settings.default_palette | escape }}"
    data-palette-access="{{ palette_access_string | escape }}"
    data-app-base-url=""
    data-is-admin="{% if palette_access_string contains ',YCS_ADMIN,' %}true{% else %}false{% endif %}"
    data-is-trade-july-cohort="{% if is_trade_july_cohort %}true{% else %}false{% endif %}"
    data-is-trade-sept-cohort="{% if is_trade_sept_cohort %}true{% else %}false{% endif %}"
    data-is-style-masters="{% if palette_access_string contains ',VIP,' %}true{% else %}false{% endif %}"
  >
    <div id="palette-unauthorized" class="ycs-palette-login" style="display:none;">
      <div class="ycs-palette-login__inner">
        <p class="ycs-palette-login__kicker">Your Color Style</p>
        <h1 class="ycs-palette-login__title">This palette is not available on your account</h1>
        <p class="ycs-palette-login__text">
          Please return to My Color Palettes to open a palette you have access to.
        </p>
        <a href="/pages/ycs-color-palettes" class="ycs-palette-login__button">
          Go to YCS Color Palettes
        </a>
      </div>
    </div>

    <div id="palette-authorized-content">
      <div class="ycs-palette-topnav">

        <a class="ycs-palette-nav-link" href="/">Dashboard</a>
        <a class="ycs-palette-nav-link" href="/pages/ycs-color-palettes">YCS Color Palettes</a>
        {% if is_admin %}
          <a class="ycs-palette-nav-link" href="/pages/my-wardrobes">My Wardrobes</a>
        {% endif %}
        <a class="ycs-palette-nav-link ycs-member-palette-contact" href="mailto:gailscottstyle@gmail.com">Contact</a>
      </div>

      <div class="ycs-palette-header">
        <p class="ycs-palette-kicker">Your Color Style Digital Color Fan</p>
        <h1 id="palette-title">Loading palette...</h1>
        <p id="palette-subtitle" class="ycs-palette-subtitle"></p>
      </div>

      <div class="ycs-palette-toolbar">

        <div id="palette-view-toggle" class="ycs-view-toggle">
          <button
            type="button"
            id="palette-scan-toggle"
            class="ycs-scan-toggle"
            aria-pressed="false"
            aria-label="Toggle scan view"
            title="Toggle scan view">

            <span class="ycs-icon-grid">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1"></rect>
              </svg>
            </span>

            <span class="ycs-icon-list">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <rect x="4" y="5" width="16" height="3" rx="1"></rect>
                <rect x="4" y="10.5" width="16" height="3" rx="1"></rect>
                <rect x="4" y="16" width="16" height="3" rx="1"></rect>
              </svg>
            </span>
          </button>
        </div>
        {% assign has_starter = false %}
{% if palette_access_string contains ',DRAPINGSTUDIOSTARTER,' %}
  {% assign has_starter = true %}
{% endif %}

{% assign has_full = false %}
{% if palette_access_string contains ',DRAPINGSTUDIO,' %}
  {% assign has_full = true %}
{% endif %}

{% assign is_sample = false %}
{% if has_starter == false and has_full == false and palette_access_string contains ',SAMPLE,' %}
  {% assign is_sample = true %}
{% endif %}

{% assign is_vip = false %}
{% if palette_access_string contains ',VIP,' %}
  {% assign is_vip = true %}
{% endif %}

{% assign has_paid_access = false %}
{% if has_starter or has_full or is_vip or is_admin %}
  {% assign has_paid_access = true %}
{% endif %}
{% unless has_color_analysis_tools_access %}
  <a
    id="ycs-open-photo-draping"
    class="ycs-open-photo-draping-btn"
    href="{% if has_paid_access %}
  /pages/my-photos?mode=personal&palette={{ request.params.palette | default: section.settings.default_palette | escape }}
  {% else %}
  /pages/my-photos?mode=personal&trial=sample&palette={{ request.params.palette | default: section.settings.default_palette | escape }}
{% endif %}">
    Draping Studio
  </a>
{% endunless %}
        {% if is_admin %}
        <button
          type="button"
          id="ycs-download-palette-pngs"
          class="ycs-download-palette-pngs-btn"
          disabled>
          PNG
        </button>
        {% endif %}
        <div class="ycs-category-nav-wrap">
          <nav id="category-nav" class="ycs-category-nav"></nav>
        </div>
      </div>

      <div id="palette-sections" class="ycs-palette-sections"></div>

      <p id="palette-message" class="ycs-palette-message"></p>
    </div>
  </div>
{% endif %}

<style>
  .shopify-section-header, #shopify-section-header, .site-header, .header-wrapper, .header, #shopify-section-footer, .shopify-section--footer, .site-footer, footer.footer, footer[role="contentinfo"] { display: none !important; }
  body { margin-top: 0 !important; padding-top: 0 !important; }
  .ycs-palette-nav-link.ycs-member-palette-contact { margin-left: auto !important; }
  .ycs-category-nav-wrap {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
  }

