</style>

<script>
  document.addEventListener('DOMContentLoaded', async function () {
    const savedScrollAtLoad = sessionStorage.getItem('paletteScroll');
    if (savedScrollAtLoad) {
      setTimeout(() => {
        window.scrollTo(0, Number(savedScrollAtLoad));
        sessionStorage.removeItem('paletteScroll');
      }, 100);
    }

    const loginReturnLink = document.querySelector('.js-login-return-link');
    if (loginReturnLink) {
      const currentUrl = window.location.pathname + window.location.search;
      loginReturnLink.href = `{{ routes.account_login_url }}?return_url=${encodeURIComponent(currentUrl)}`;
    }

    const app = document.querySelector('.ycs-palette-app');
    if (!app) return;

    const customerId = app.dataset.customerId || null;
    const email = app.dataset.customerEmail || null;
    const paletteAccessString = (app.dataset.paletteAccess || '').toUpperCase();
    const accessIsAdmin = app.dataset.isAdmin === 'true';
    const isStyleMasters = app.dataset.isStyleMasters === 'true';
    const isLoggedIn = !!customerId;

    const PALETTE_CODES = [
      'CWL', 'CWM', 'CWD',
      'CWLG', 'CWMG', 'CWDG',
      'CCL', 'CCM', 'CCD',
      'SWL', 'SWM', 'SWD',
      'SWLG', 'SWMG', 'SWDG',
      'SCL', 'SCM', 'SCD',
      'LO', 'MO', 'DO'
    ];

    const ownedPalettes = PALETTE_CODES.filter((code) =>
      paletteAccessString.includes(`,${code},`)
    );

    const accessPayload = {
      customerId,
      email,
      isLoggedIn,
      isAdmin: accessIsAdmin,
      isStyleMasters,
      ownedPalettes,
      features: {
        palette_viewer: isLoggedIn,
        favorites: isLoggedIn,
        compare_tool: accessIsAdmin || isStyleMasters,
        color_combos: accessIsAdmin || isStyleMasters,
        photo_draping: accessIsAdmin || isStyleMasters
      }
    };

    window.YCS_ACCESS = accessPayload;

    const DEFAULT_PALETTE = app.dataset.defaultPalette || 'CWL';
    const PALETTE_ACCESS = app.dataset.paletteAccess || '';
    const CUSTOMER_ID = app.dataset.customerId || '';
    const APP_BASE_URL = (app.dataset.appBaseUrl || window.location.origin).replace(/\/$/, '');

    const unauthorizedEl = document.getElementById('palette-unauthorized');
    const authorizedContentEl = document.getElementById('palette-authorized-content');

    const titleEl = document.getElementById('palette-title');
    const subtitleEl = document.getElementById('palette-subtitle');
    const navEl = document.getElementById('category-nav');
    const sectionsEl = document.getElementById('palette-sections');
    const messageEl = document.getElementById('palette-message');
    const scanToggleEl = document.getElementById('palette-scan-toggle');
    const openPhotoDrapingEl = document.getElementById('ycs-open-photo-draping');
    const downloadPalettePngsEl = document.getElementById('ycs-download-palette-pngs');

    const params = new URLSearchParams(window.location.search);
    const returnUrl = params.get('returnUrl') || '/pages/ycs-color-palettes';
    const safeReturnUrl = returnUrl.startsWith('/') ? returnUrl : '/pages/ycs-color-palettes';
    const returnLabel = 'YCS Color Palettes';
    const backLinkEl = document.querySelector('.ycs-palette-nav-link[href="/pages/ycs-color-palettes"]');
    const unauthorizedReturnButtonEl = document.querySelector('#palette-unauthorized .ycs-palette-login__button');
    const unauthorizedReturnTextEl = document.querySelector('#palette-unauthorized .ycs-palette-login__text');

    if (backLinkEl) {
      backLinkEl.href = '/pages/ycs-color-palettes';
      backLinkEl.textContent = returnLabel;
    }

    if (unauthorizedReturnButtonEl) {
      unauthorizedReturnButtonEl.href = safeReturnUrl;
      unauthorizedReturnButtonEl.textContent = `Go to ${returnLabel}`;
    }

    if (unauthorizedReturnTextEl) {
      unauthorizedReturnTextEl.textContent = `Please return to ${returnLabel} to open a palette you have access to.`;
    }

    const rawPaletteCode = (params.get('palette') || DEFAULT_PALETTE).trim();
    const isCustomPaletteCode = /^CUSTOM_/i.test(rawPaletteCode);
    const paletteCode = isCustomPaletteCode ? rawPaletteCode : rawPaletteCode.toUpperCase();
    const hasPaidDrapingAccess =
    paletteAccessString.includes(',DRAPINGSTUDIOSTARTER,') ||
    paletteAccessString.includes(',DRAPINGSTUDIO,') ||
    paletteAccessString.includes(',VIP,') ||
    paletteAccessString.includes(',YCS_ADMIN,');
    const hasSampleTrialAccess =
      paletteCode === 'SAMPLE' &&
      isLoggedIn &&
      !hasPaidDrapingAccess;

    if (openPhotoDrapingEl) {
  if (hasPaidDrapingAccess) {
    openPhotoDrapingEl.href =
      `/pages/my-photos?mode=personal&palette=${encodeURIComponent(paletteCode)}`;
  } else {
    openPhotoDrapingEl.href =
      `/pages/my-photos?mode=personal&trial=sample&palette=${encodeURIComponent(paletteCode)}`;
  }
}
    const paletteToken = `,${paletteCode},`;
    const hasAdminAccess = PALETTE_ACCESS.includes(',YCS_ADMIN,');
const hasTradeAccess = PALETTE_ACCESS.includes(',TRADE,') || app.dataset.isTradeJulyCohort === 'true';
const hasCatoolAccess = PALETTE_ACCESS.includes(',CATOOL,');
const hasYcsProAccess = PALETTE_ACCESS.includes(',YCSPRO,');
const hasYcsMemberAccess = PALETTE_ACCESS.includes(',YCSMEMBER,') || PALETTE_ACCESS.includes(',TRADE,');
const hasTradeSeptCohortAccess = app.dataset.isTradeSeptCohort === 'true';

const hasAllPaletteAccess =
  hasAdminAccess ||
  hasTradeAccess ||
  hasCatoolAccess ||
  hasYcsProAccess ||
  hasYcsMemberAccess ||
  hasTradeSeptCohortAccess;

const isAdminPalette = paletteCode.startsWith('ADMIN_');
const adminAggregatePaletteCodes = {
  ADMIN_CLEAR: ['CWL', 'CWM', 'CWD', 'CCL', 'CCM', 'CCD', 'CWLG', 'CWMG', 'CWDG'],
  ADMIN_SOFT: ['SWL', 'SWM', 'SWD', 'SCL', 'SCM', 'SCD', 'SWLG', 'SWMG', 'SWDG']
};
const isAdminAggregatePalette = Object.prototype.hasOwnProperty.call(adminAggregatePaletteCodes, paletteCode);
const isStyleMastersCustomPalette = isCustomPaletteCode && (
  PALETTE_ACCESS.includes(',VIP,') ||
  hasAdminAccess
);

const hasAccess =
  PALETTE_ACCESS.includes(paletteToken) ||
  hasSampleTrialAccess ||
  hasAllPaletteAccess ||
  (hasAdminAccess && isAdminPalette) ||
  isStyleMastersCustomPalette;

    if (!hasAccess) {
      if (authorizedContentEl) authorizedContentEl.style.display = 'none';
      if (unauthorizedEl) unauthorizedEl.style.display = '';
      return;
    }


    const paletteNameMap = {
      CWL: 'Clear Warm Light',
      CWM: 'Clear Warm Medium',
      CWD: 'Clear Warm Deep',
      CCL: 'Clear Cool Light',
      CCM: 'Clear Cool Medium',
      CCD: 'Clear Cool Deep',
      SWL: 'Soft Warm Light',
      SWM: 'Soft Warm Medium',
      SWD: 'Soft Warm Deep',
      SCL: 'Soft Cool Light',
      SCM: 'Soft Cool Medium',
      SCD: 'Soft Cool Deep',
      CWLG: 'Clear Warm Light for Gray Hair',
      CWMG: 'Clear Warm Medium for Gray Hair',
      CWDG: 'Clear Warm Deep for Gray Hair',
      SWLG: 'Soft Warm Light for Gray Hair',
      SWMG: 'Soft Warm Medium for Gray Hair',
      SWDG: 'Soft Warm Deep for Gray Hair',
      LO: 'Light Olive',
      MO: 'Medium Olive',
      DO: 'Deep Olive',
      ADMIN_ALL: 'All Colors Across Palettes',
      ADMIN_CLEAR: 'All Clear Colors',
      ADMIN_SOFT: 'All Soft Colors'
    };

    const categoryOrder = [
      'Favorites',
      'Best',
      'Reds',
      'Oranges',
      'Golden Yellows',
      'Yellows',
      'Yellow Greens',
      'Greens',
      'Aquas/Teals',
      'Blues',
      'Indigos',
      'Purples',
      'Plums',
      'Magentas',
      'Pinks',
      'Neutrals'
    ];

    const viewModeStorageKey = `ycsViewMode_${paletteCode}`;
    const PALETTE_EXPORT_LOGO_URL = {% if settings.logo != blank %}{{ settings.logo | img_url: '300x' | json }}{% elsif settings.logo_cl != blank %}{{ settings.logo_cl | img_url: '300x' | json }}{% else %}''{% endif %};

    let currentViewMode = sessionStorage.getItem(viewModeStorageKey) || 'labeled';

    let sourceAllColors = [];
    let renderedGrouped = {};
    let renderedOrderedCategories = [];
    let renderedFlatColors = [];
    let favoriteHexes = new Set();
    let paletteExportLogoImagePromise = null;
    let currentPaletteExportName = paletteNameMap[paletteCode] || paletteCode;

    function slugify(text) {
      return String(text)
        .toLowerCase()
        .replace(/&/g, 'and')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    function normalizeHex(hex) {
      return String(hex || '').trim().toLowerCase();
    }

    function getCustomPaletteIdFromCode(code) {
      return String(code || '').replace(/^CUSTOM_/i, '');
    }

    function mapCustomPaletteColors(palette) {
      return ((palette && palette.colors) || []).map((join, index) => {
        const color = join.color || {};
        return {
          name: color.name || 'Custom Color',
          hex: normalizeHex(color.hexCode),
          hexCode: normalizeHex(color.hexCode),
          category: color.category || '',
          sortOrder: Number(join.displayOrder) || index
        };
      });
    }

    async function fetchCustomPaletteForViewer() {
      const paletteId = getCustomPaletteIdFromCode(paletteCode);
      if (!APP_BASE_URL || !CUSTOMER_ID || !paletteId) {
        throw new Error('No colors returned');
      }

      const query = new URLSearchParams({
        action: isStyleMasters && !hasAdminAccess ? 'vipList' : 'list',
        customerId: CUSTOMER_ID,
        paletteId: paletteId
      });
      if (hasAdminAccess) query.set('scope', 'stylemasters');

      const response = await fetch(APP_BASE_URL + '/api/custom-palettes?' + query.toString(), {
        credentials: 'same-origin'
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'No colors returned');

      const palette =
        (data.palettes || []).find(item => String(item.id) === paletteId) ||
        data.palette ||
        (Array.isArray(data.palettes) && data.palettes.length === 1 ? data.palettes[0] : null);

      if (!palette && Array.isArray(data.colors)) {
        return {
          paletteName: 'Style Masters Palette',
          colors: data.colors.map((color, index) => ({
            name: color.name || 'Custom Color',
            hex: normalizeHex(color.hex || color.hexCode),
            hexCode: normalizeHex(color.hex || color.hexCode),
            category: color.category || '',
            sortOrder: Number(color.sortOrder) || index
          }))
        };
      }

      if (!palette) throw new Error('No colors returned');

      return {
        paletteName: palette.name || 'Style Masters Palette',
        colors: mapCustomPaletteColors(palette)
      };
    }

    function mapYcsPaletteColor(color, index, paletteIndex, options = {}) {
      const baseSortOrder = Number(color.sortOrder || color.SortOrder) || index;
      return {
        name: color.name || color.ColorName || '',
        hex: normalizeHex(color.hex || color.Hex || color.hexCode || color.HexCode),
        hexCode: normalizeHex(color.hex || color.Hex || color.hexCode || color.HexCode),
        category: color.category || color.Category || '',
        sortOrder: options.preservePaletteOrder ? (paletteIndex * 10000) + baseSortOrder : baseSortOrder,
        paletteCodes: color.paletteCodes || color.palettes || color.PaletteCodes_Final_Manual || '',
        depth: color.depth || color.Depth || '',
        temperature: color.temperature || color.Temperature || '',
        chroma: color.chroma || color.Chroma || '',
        isNeutral: color.isNeutral ?? color.IsNeutral ?? false,
        neutralDepth: color.neutralDepth || color.NeutralDepth || '',
        isBest: color.isBest ?? color.IsBest ?? false
      };
    }

    async function fetchYcsPaletteColors(paletteCodeToFetch, paletteIndex, options = {}) {
      const colorsResponse = await fetch(`/apps/palette-data?palette=${encodeURIComponent(paletteCodeToFetch)}`, {
        credentials: 'same-origin'
      });
      const data = await colorsResponse.json();

      if (!colorsResponse.ok || !data.colors) {
        throw new Error(data.error || `No colors returned for ${paletteCodeToFetch}`);
      }

      return data.colors.map((color, index) => mapYcsPaletteColor(color, index, paletteIndex, options));
    }

    async function fetchAdminAggregatePaletteForViewer() {
      const aggregateCodes = adminAggregatePaletteCodes[paletteCode] || [];
      const palettes = await Promise.all(
        aggregateCodes.map((code, index) => fetchYcsPaletteColors(code, index, { preservePaletteOrder: false }))
      );
      const seen = new Set();
      const colors = [];

      palettes.flat().forEach(color => {
        const hex = normalizeHex(color.hex || color.hexCode);
        const key = `${hex}|${normalizeText(color.name)}`;
        if (!hex || seen.has(key)) return;
        seen.add(key);
        colors.push(color);
      });

      return {
        paletteName: paletteNameMap[paletteCode] || paletteCode,
        colors
      };
    }

    function normalizeText(value) {
      return String(value || '').trim().toLowerCase();
    }

    function normalizeDepth(value) {
      const normalized = normalizeText(value);
      if (!normalized) return '';
      return normalized.charAt(0).toUpperCase() + normalized.slice(1);
    }

    function colorUrl(hex, name) {
      return `/pages/member-color?hex=${encodeURIComponent(String(hex).replace('#', ''))}&name=${encodeURIComponent(name)}&palette=${encodeURIComponent(paletteCode)}`;
    }

    function getPaletteExportName() {
      return currentPaletteExportName || paletteNameMap[paletteCode] || paletteCode;
    }

    function getPaletteExportFileBase() {
      return slugify(`${paletteCode}-${getPaletteExportName()}`) || slugify(paletteCode) || 'palette';
    }

    function getExportTextColor(hex) {
      const normalized = String(hex || '').replace('#', '').trim();
      if (!/^[0-9a-f]{6}$/i.test(normalized)) return '#ffffff';

      const r = parseInt(normalized.slice(0, 2), 16) / 255;
      const g = parseInt(normalized.slice(2, 4), 16) / 255;
      const b = parseInt(normalized.slice(4, 6), 16) / 255;
      const linearRgb = [r, g, b].map(value => {
        return value <= 0.03928
          ? value / 12.92
          : Math.pow((value + 0.055) / 1.055, 2.4);
      });
      const luminance = 0.2126 * linearRgb[0] + 0.7152 * linearRgb[1] + 0.0722 * linearRgb[2];

      return luminance > 0.5 ? '#111111' : '#ffffff';
    }

    function wrapCanvasText(ctx, text, maxWidth) {
      const words = String(text || '').split(/\s+/).filter(Boolean);
      const lines = [];
      let line = '';

      words.forEach(word => {
        const testLine = line ? `${line} ${word}` : word;
        if (ctx.measureText(testLine).width <= maxWidth || !line) {
          line = testLine;
        } else {
          lines.push(line);
          line = word;
        }
      });

      if (line) lines.push(line);
      return lines;
    }

    async function downloadCanvasPng(canvas, fileName) {
      return new Promise((resolve, reject) => {
        canvas.toBlob(blob => {
          if (!blob) {
            reject(new Error('Could not create PNG'));
            return;
          }

          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = fileName;
          document.body.appendChild(link);
          link.click();
          link.remove();

          setTimeout(() => {
            URL.revokeObjectURL(url);
            resolve();
          }, 150);
        }, 'image/png');
      });
    }

    function loadPaletteExportLogoImage() {
      if (!PALETTE_EXPORT_LOGO_URL) return Promise.resolve(null);
      if (paletteExportLogoImagePromise) return paletteExportLogoImagePromise;

      paletteExportLogoImagePromise = new Promise(resolve => {
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = function () {
          resolve(img);
        };
        img.onerror = function () {
          resolve(null);
        };
        img.src = PALETTE_EXPORT_LOGO_URL;
      });

      return paletteExportLogoImagePromise;
    }

    function drawPaletteExportLogo(ctx, logoImg, x, y, cellWidth, cellHeight) {
      if (logoImg) {
        const maxWidth = cellWidth * 0.68;
        const maxHeight = cellHeight * 0.5;
        const logoRatio = logoImg.naturalWidth / logoImg.naturalHeight;
        let drawWidth = maxWidth;
        let drawHeight = drawWidth / logoRatio;

        if (drawHeight > maxHeight) {
          drawHeight = maxHeight;
          drawWidth = drawHeight * logoRatio;
        }

        ctx.drawImage(
          logoImg,
          x + (cellWidth - drawWidth) / 2,
          y + (cellHeight - drawHeight) / 2,
          drawWidth,
          drawHeight
        );
        return;
      }

      ctx.fillStyle = '#111111';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.font = '400 22px Arial, sans-serif';
      ctx.fillText('YOUR COLOR STYLE', x + cellWidth / 2, y + cellHeight / 2);
    }

    async function drawPalettePngPage(colors) {
      const width = 1800;
      const height = 1200;
      const columns = 6;
      const rows = 4;
      const cellWidth = width / columns;
      const cellHeight = height / rows;
      const colorsPerPage = columns * rows;
      const shouldDrawLogo = colors.length < colorsPerPage;
      const lowerLeftIndex = (rows - 1) * columns;
      const logoImg = shouldDrawLogo ? await loadPaletteExportLogoImage() : null;

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;

      const ctx = canvas.getContext('2d');

      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, width, height);

      colors.forEach((color, index) => {
        const column = index % columns;
        const row = Math.floor(index / columns);
        const x = column * cellWidth;
        const y = row * cellHeight;
        const hex = color.hex || '#eeeeee';
        const isLowerLeftSwatch = column === 0 && row === rows - 1;

        ctx.fillStyle = hex;
        ctx.fillRect(x, y, cellWidth, cellHeight);

        ctx.fillStyle = getExportTextColor(hex);
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.font = '400 24px Arial, sans-serif';

        const nameLines = wrapCanvasText(ctx, color.name || '', cellWidth - 24).slice(0, 3);
        const lineHeight = 28;
        const firstLineY = y + 52;

        nameLines.forEach((line, lineIndex) => {
          ctx.fillText(line, x + cellWidth / 2, firstLineY + lineIndex * lineHeight);
        });

        if (isLowerLeftSwatch) {
          ctx.fillStyle = '#111111';
          ctx.font = '400 24px Arial, sans-serif';
          ctx.fillText(
            paletteCode.toUpperCase(),
            x + cellWidth / 2,
            Math.max(y + cellHeight / 2, firstLineY + nameLines.length * lineHeight + 10)
          );
        }
      });

      if (colors.length <= lowerLeftIndex) {
        ctx.fillStyle = '#111111';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.font = '400 24px Arial, sans-serif';
        ctx.fillText(
          paletteCode.toUpperCase(),
          cellWidth / 2,
          (rows - 1) * cellHeight + cellHeight / 2
        );
      }

      if (shouldDrawLogo) {
        drawPaletteExportLogo(
          ctx,
          logoImg,
          (columns - 1) * cellWidth,
          (rows - 1) * cellHeight,
          cellWidth,
          cellHeight
        );
      }

      return canvas;
    }

    function getNeutralFamilyExportRank(color) {
      const family = getNeutralFamily(color) || 'Other Neutrals';
      const neutralFamilyOrder = [
        'Creams',
        'Olive Greens',
        'Mustard & Golden Olives',
        'Warm Browns',
        'Red Browns',
        'Browns',
        'Navy Blues',
        'Grays',
        'Taupes',
        'Black Alternatives',
        'Other Neutrals'
      ];
      const index = neutralFamilyOrder.findIndex(name => name.toLowerCase() === family.toLowerCase());

      return index === -1 ? neutralFamilyOrder.length : index;
    }

    function sortNeutralExportColors(colors) {
      return colors.slice().sort((a, b) => {
        const aIsLight = getDepthLabel(a) === 'Light';
        const bIsLight = getDepthLabel(b) === 'Light';

        if (aIsLight && !bIsLight) return -1;
        if (!aIsLight && bIsLight) return 1;

        if (aIsLight && bIsLight) {
          return (a.sortOrder || 0) - (b.sortOrder || 0);
        }

        const familyRankCompare = getNeutralFamilyExportRank(a) - getNeutralFamilyExportRank(b);
        if (familyRankCompare !== 0) return familyRankCompare;

        const familyCompare = (getNeutralFamily(a) || 'Other Neutrals')
          .localeCompare(getNeutralFamily(b) || 'Other Neutrals');
        if (familyCompare !== 0) return familyCompare;

        const depthCompare = getDepthRank(a) - getDepthRank(b);
        if (depthCompare !== 0) return depthCompare;

        return (a.sortOrder || 0) - (b.sortOrder || 0);
      });
    }

    function getPalettePngExportColors() {
      const exportColors = renderedOrderedCategories
        .filter(category => category !== 'Favorites' && category !== 'Best')
        .flatMap(category => {
          const colors = (renderedGrouped[category] || []).filter(color => color && color.hex && color.name);
          return category === 'Neutrals' ? sortNeutralExportColors(colors) : colors;
        })
        .filter(color => color && color.hex && color.name);

      return exportColors.length
        ? exportColors
        : renderedFlatColors.filter(color => color && color.hex && color.name);
    }

    function getColorExportCategory(color) {
      return String(color && color.category ? color.category : '').trim();
    }

    function paginatePalettePngColors(colors, colorsPerPage) {
      const lastRowStartIndex = 18;
      const pages = [];
      let page = [];

      colors.forEach(color => {
        const currentCategory = getColorExportCategory(color);
        const previousColor = page[page.length - 1] || null;
        const previousCategory = getColorExportCategory(previousColor);
        const startsNewCategory =
          page.length > 0 &&
          currentCategory &&
          previousCategory &&
          currentCategory !== previousCategory;
        const shouldStartNeutralsPage =
          page.length > 0 &&
          currentCategory === 'Neutrals' &&
          previousCategory !== 'Neutrals';

        if (shouldStartNeutralsPage) {
          pages.push(page);
          page = [];
        }

        if (page.length >= lastRowStartIndex && startsNewCategory) {
          pages.push(page);
          page = [];
        }

        if (page.length >= colorsPerPage) {
          pages.push(page);
          page = [];
        }

        page.push(color);
      });

      if (page.length) pages.push(page);
      return pages;
    }

    async function downloadPalettePngs() {
      const colors = getPalettePngExportColors();
      const colorsPerPage = 24;

      if (!colors.length) {
        messageEl.textContent = 'No colors are ready to export yet.';
        return;
      }

      if (downloadPalettePngsEl) downloadPalettePngsEl.disabled = true;

      try {
        const pages = paginatePalettePngColors(colors, colorsPerPage);
        const pageCount = pages.length;
        const fileBase = getPaletteExportFileBase();

        messageEl.textContent = `Creating ${pageCount} PNG${pageCount === 1 ? '' : 's'}...`;

        for (let pageIndex = 0; pageIndex < pageCount; pageIndex += 1) {
          const pageColors = pages[pageIndex];
          const canvas = await drawPalettePngPage(pageColors);
          const fileName = `${fileBase}-${String(pageIndex + 1).padStart(2, '0')}-of-${String(pageCount).padStart(2, '0')}.png`;

          await downloadCanvasPng(canvas, fileName);

          if (pageIndex < pageCount - 1) {
            await new Promise(resolve => setTimeout(resolve, 250));
          }
        }

        messageEl.textContent = `Downloaded ${pageCount} PNG${pageCount === 1 ? '' : 's'} at 1800 x 1200 px.`;
      } catch (error) {
        console.error(error);
        messageEl.textContent = 'Could not create the PNG files. Please try again.';
      } finally {
        if (downloadPalettePngsEl) downloadPalettePngsEl.disabled = !renderedFlatColors.length;
      }
    }

    function gradientForColors(colors) {
      const hexes = colors
        .map(c => c.hex)
        .filter(Boolean)
        .slice(0, 6);

      if (!hexes.length) return '#ddd';
      if (hexes.length === 1) return hexes[0];
      return `linear-gradient(to right, ${hexes.join(', ')})`;
    }

    function getDepthLabel(color) {
      const depthValue = normalizeDepth(color.isNeutral ? color.neutralDepth : color.depth);

      if (depthValue === 'Light') return 'Light';
      if (depthValue === 'Medium') return 'Medium';
      if (depthValue === 'Deep') return 'Dark';
      return '';
    }

    function cleanCategoryList(categories) {
      return (categories || [])
        .map(category => String(category || '').trim())
        .filter(Boolean);
    }

    function renderCategoryNav(categories, activeCategory = 'All') {
      categories = cleanCategoryList(categories);

      const favoriteExists = categories.includes('Favorites');
      const regularCategories = categories.filter(category => category !== 'Favorites');

      const favoritesButton = favoriteExists ? `
        <button
          type="button"
          class="ycs-category-link ycs-category-link--icon${activeCategory === 'Favorites' ? ' is-active' : ''}"
          data-category="Favorites"
          aria-label="Favorites"
          title="Favorites">
          <span class="ycs-category-link__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 20.2c-.2 0-.4-.1-.6-.2C10.1 19 4 14.7 4 9.6 4 6.9 5.9 5 8.5 5c1.5 0 2.8.7 3.5 1.8C12.7 5.7 14 5 15.5 5 18.1 5 20 6.9 20 9.6c0 5.1-6.1 9.4-7.4 10.4-.2.1-.4.2-.6.2z"></path>
            </svg>
          </span>
        </button>
      ` : '';

      const allButton = `
        <button
          type="button"
          class="ycs-category-link${activeCategory === 'All' ? ' is-active' : ''}"
          data-category="All">
          All
        </button>
      `;

      const otherButtons = regularCategories.map(category => {
        const activeClass = category === activeCategory ? ' is-active' : '';
        return `
          <button
            type="button"
            class="ycs-category-link${activeClass}"
            data-category="${escapeMarkup(category)}">
            ${escapeMarkup(category)}
          </button>
        `;
      }).join('');

      navEl.innerHTML = favoritesButton + allButton + otherButtons;

      navEl.querySelectorAll('.ycs-category-link').forEach(button => {
        button.addEventListener('click', () => {
          const selectedCategory = button.dataset.category;
          setActiveCategory(selectedCategory, categories);
          requestAnimationFrame(() => {
            centerActiveCategoryLink();
            updateCategoryNavFade();
          });
        });
      });

      requestAnimationFrame(() => {
        updateCategoryNavFade();
      });
    }

    function updateCategoryNavFade() {
      const navWrap = document.querySelector('.ycs-category-nav-wrap');
      if (!navWrap || !navEl) return;

      const maxScrollLeft = navEl.scrollWidth - navEl.clientWidth;
      const atLeft = navEl.scrollLeft <= 4;
      const atRight = navEl.scrollLeft >= maxScrollLeft - 4;

      navWrap.classList.toggle('is-left-hidden', atLeft);
      navWrap.classList.toggle('is-right-hidden', atRight);
    }

    function centerActiveCategoryLink() {
      if (!navEl) return;

      const activeLink = navEl.querySelector('.ycs-category-link.is-active');
      if (!activeLink) return;

      const navRect = navEl.getBoundingClientRect();
      const linkRect = activeLink.getBoundingClientRect();
      const currentScroll = navEl.scrollLeft;
      const targetScroll = currentScroll + (linkRect.left - navRect.left) - (navRect.width / 2) + (linkRect.width / 2);

      navEl.scrollTo({
        left: Math.max(0, targetScroll),
        behavior: 'smooth'
      });
    }

    function setActiveCategory(activeCategory, categories) {
      categories = cleanCategoryList(categories);
      sessionStorage.setItem(`ycsActiveCategory_${paletteCode}`, activeCategory);

      renderCategoryNav(categories, activeCategory);

      const sections = sectionsEl.querySelectorAll('.ycs-palette-section');

      sections.forEach(section => {
        const sectionCategory = section.dataset.category;

        if (activeCategory === 'All' && sectionCategory !== 'Favorites') {
          section.style.display = '';
        } else if (sectionCategory === activeCategory) {
          section.style.display = '';
        } else {
          section.style.display = 'none';
        }
      });

      requestAnimationFrame(() => {
        centerActiveCategoryLink();
        updateCategoryNavFade();
      });
    }

    function escapeMarkup(value) {
      return String(value || '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    }
    function swatchMarkup(color) {
      const isFavorite = !!color.isFavorite;
      const favoriteClass = isFavorite ? ' is-favorite' : '';

      return `
        <a
          class="ycs-swatch-link"
          href="${colorUrl(color.hex, color.name)}"
          data-color-hex="${color.hex}"
          data-color-name="${escapeMarkup(color.name)}">
          <button
            type="button"
            class="ycs-fav-btn${favoriteClass}"
            data-favorite-hex="${color.hex}"
            data-favorite-name="${escapeMarkup(color.name)}"
            aria-label="${isFavorite ? 'Remove from favorites' : 'Add to favorites'}"
            title="${isFavorite ? 'Remove from favorites' : 'Add to favorites'}">
            <svg class="ycs-fav-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 20.2c-.2 0-.4-.1-.6-.2C10.1 19 4 14.7 4 9.6 4 6.9 5.9 5 8.5 5c1.5 0 2.8.7 3.5 1.8C12.7 5.7 14 5 15.5 5 18.1 5 20 6.9 20 9.6c0 5.1-6.1 9.4-7.4 10.4-.2.1-.4.2-.6.2z"></path>
            </svg>
          </button>
          <div class="ycs-swatch-tile" style="background: ${color.hex};"></div>
          <div class="ycs-swatch-name">${escapeMarkup(color.name)}</div>
        </a>
      `;
    }

    function getNeutralFamily(color) {
      return String(
        color.neutralFamily ||
        color.NeutralFamily ||
        color.neutral_family ||
        ''
      ).trim();
    }

    function renderNeutralsSwatches(colors) {
      const lightColors = [];
      const groupedFamilies = {};

      colors.forEach(color => {
        const depthLabel = getDepthLabel(color);

        if (depthLabel === 'Light') {
          lightColors.push(color);
          return;
        }

        const family = getNeutralFamily(color) || 'Other Neutrals';

        if (!groupedFamilies[family]) {
          groupedFamilies[family] = [];
        }

        groupedFamilies[family].push(color);
      });

      let html = '';

      if (lightColors.length) {
        html += `
          <div class="ycs-depth-group">
            <h3 class="ycs-depth-group__title">Light Neutrals</h3>
            <div class="ycs-swatch-grid">
              ${lightColors.map(color => swatchMarkup(color)).join('')}
            </div>
          </div>
        `;
      }

      const neutralFamilyOrder = [
        'Creams',
        'Olive Greens',
        'Mustard & Golden Olives',
        'Warm Browns',
        'Red Browns',
        'Browns',
        'Navy Blues',
        'Grays',
        'Taupes',
        'Black Alternatives'
      ];

      const familyKeys = Object.keys(groupedFamilies);
      const orderedFamilies = [
        ...neutralFamilyOrder
          .map(orderName => familyKeys.find(family => family.trim().toLowerCase() === orderName.trim().toLowerCase()))
          .filter(Boolean),
        ...familyKeys.filter(family => !neutralFamilyOrder.some(orderName => family.trim().toLowerCase() === orderName.trim().toLowerCase()))
      ];

      orderedFamilies.forEach(family => {
        const familyColors = groupedFamilies[family] || [];

        if (!familyColors.length) return;

        html += `
          <div class="ycs-depth-group">
            <h3 class="ycs-subcategory-heading">${escapeMarkup(family)}</h3>
            <div class="ycs-swatch-grid">
              ${familyColors.map(color => swatchMarkup(color)).join('')}
            </div>
          </div>
        `;
      });

      return html;
    }

    function renderDepthGroupedSwatches(colors, categoryName) {
      if (categoryName === 'Neutrals') {
        return renderNeutralsSwatches(colors);
      }

      const groupedByDepth = {
        Light: [],
        Medium: [],
        Dark: [],
        Other: []
      };

      colors.forEach(color => {
        const depthLabel = getDepthLabel(color);

        if (depthLabel === 'Light') groupedByDepth.Light.push(color);
        if (depthLabel === 'Medium') groupedByDepth.Medium.push(color);
        if (depthLabel === 'Dark') groupedByDepth.Dark.push(color);
        if (!['Light','Medium','Dark'].includes(depthLabel)) groupedByDepth.Other.push(color);
      });

      return ['Light', 'Medium', 'Dark', 'Other']
        .filter(depth => groupedByDepth[depth].length)
        .map(depth => {
          let label = depth === 'Other' ? categoryName : `${depth} ${categoryName}`;

          if (categoryName === 'Reds' && depth === 'Light') {
            label = 'Corals';
          }

          return `
            <div class="ycs-depth-group">
              <h3 class="ycs-depth-group__title">${escapeMarkup(label)}</h3>
              <div class="ycs-swatch-grid">
                ${groupedByDepth[depth].map(color => swatchMarkup(color)).join('')}
              </div>
            </div>
          `;
        })
        .join('');
    }

    function renderSections(grouped, orderedCategories, flatColors = []) {
      if (!flatColors.length) {
        sectionsEl.innerHTML = '';
        return;
      }

      if (currentViewMode === 'compact') {
        sectionsEl.innerHTML = `
          <section class="ycs-palette-section ycs-palette-section--compact" data-category="All">
            <div class="ycs-swatch-grid">
              ${flatColors.map(color => swatchMarkup(color)).join('')}
            </div>
          </section>
        `;
        return;
      }

      orderedCategories = cleanCategoryList(orderedCategories);
      const regularCategories = orderedCategories.filter(category => category !== 'Favorites');

      if (isCustomPaletteCode && !regularCategories.length) {
        const favoritesSection = (grouped['Favorites'] || []).length ? `
          <section class="ycs-palette-section ycs-palette-section--favorites" id="cat-favorites" data-category="Favorites">
            <div class="ycs-section-header">
              <h2 class="ycs-section-title">
                <span style="display:inline-flex;align-items:center;gap:8px;">
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" style="fill:#111;stroke:#111;stroke-width:1.6;">
                    <path d="M12 20.2c-.2 0-.4-.1-.6-.2C10.1 19 4 14.7 4 9.6 4 6.9 5.9 5 8.5 5c1.5 0 2.8.7 3.5 1.8C12.7 5.7 14 5 15.5 5 18.1 5 20 6.9 20 9.6c0 5.1-6.1 9.4-7.4 10.4-.2.1-.4.2-.6.2z"></path>
                  </svg>
                  Favorites
                </span>
              </h2>
              <div class="ycs-gradient-bar" style="background: ${gradientForColors(grouped['Favorites'] || [])};"></div>
            </div>
            <div class="ycs-swatch-grid">
              ${(grouped['Favorites'] || []).map(color => swatchMarkup(color)).join('')}
            </div>
          </section>
        ` : '';

        sectionsEl.innerHTML = `
          ${favoritesSection}
          <section class="ycs-palette-section" id="cat-all-colors" data-category="All">
            <div class="ycs-section-header">
              <h2 class="ycs-section-title">All Colors</h2>
              <div class="ycs-gradient-bar" style="background: ${gradientForColors(flatColors)};"></div>
            </div>
            <div class="ycs-swatch-grid">
              ${flatColors.map(color => swatchMarkup(color)).join('')}
            </div>
          </section>
        `;
        return;
      }

      sectionsEl.innerHTML = orderedCategories.map(category => {
        const colors = grouped[category] || [];
        const id = `cat-${slugify(category)}`;
        const gradient = gradientForColors(colors);

        if (category === 'Favorites' && !colors.length) {
          return `
            <section class="ycs-palette-section" id="${id}" data-category="${escapeMarkup(category)}">
              <div class="ycs-section-header">
                <h2 class="ycs-section-title">
                  <span style="display:inline-flex;align-items:center;gap:8px;">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" style="fill:#111;stroke:#111;stroke-width:1.6;">
                      <path d="M12 20.2c-.2 0-.4-.1-.6-.2C10.1 19 4 14.7 4 9.6 4 6.9 5.9 5 8.5 5c1.5 0 2.8.7 3.5 1.8C12.7 5.7 14 5 15.5 5 18.1 5 20 6.9 20 9.6c0 5.1-6.1 9.4-7.4 10.4-.2.1-.4.2-.6.2z"></path>
                    </svg>
                    Favorites
                  </span>
                </h2>
                <div class="ycs-gradient-bar" style="background: #eee;"></div>
              </div>
              <div class="ycs-empty-favorites">
                You haven’t saved any favorites yet.
              </div>
            </section>
          `;
        }

        const sectionClass = category === 'Favorites'
          ? 'ycs-palette-section ycs-palette-section--favorites'
          : 'ycs-palette-section';

        const shouldGroupByDepth =
          category !== 'Favorites' &&
          category !== 'Best' &&
          category !== 'Custom';

        return `
          <section class="${sectionClass}" id="${id}" data-category="${escapeMarkup(category)}">
            <div class="ycs-section-header">
              <h2 class="ycs-section-title">${escapeMarkup(category)}</h2>
              <div class="ycs-gradient-bar" style="background: ${gradient};"></div>
            </div>
            ${
              shouldGroupByDepth
                ? renderDepthGroupedSwatches(colors, category)
                : `<div class="ycs-swatch-grid">
                    ${colors.map(color => swatchMarkup(color)).join('')}
                  </div>`
            }
          </section>
        `;
      }).join('');
    }

    function attachSwatchClickHandlers(flatColors) {
      document.querySelectorAll('.ycs-swatch-link').forEach(link => {
        link.addEventListener('click', function (event) {
          if (event.target.closest('.ycs-fav-btn')) return;

          sessionStorage.setItem('paletteScroll', String(window.scrollY));
          sessionStorage.setItem('ycsLastColorHex', this.dataset.colorHex || '');
          sessionStorage.setItem('ycsLastColorName', this.dataset.colorName || '');

          const clickedHex = this.dataset.colorHex;
          const clickedName = this.dataset.colorName;

          const clickedIndex = flatColors.findIndex(color =>
            color.hex === clickedHex && color.name === clickedName
          );

          sessionStorage.setItem('ycsPaletteColors', JSON.stringify(flatColors));
          sessionStorage.setItem('ycsPaletteIndex', String(clickedIndex));
          sessionStorage.setItem('ycsPaletteReturnUrl', window.location.pathname + window.location.search);
        });
      });
    }

    function attachFavoriteHandlers() {
      document.querySelectorAll('.ycs-fav-btn').forEach(button => {
        button.addEventListener('click', async function (event) {
          event.preventDefault();
          event.stopPropagation();

          const hex = this.dataset.favoriteHex || '';
          const name = this.dataset.favoriteName || '';
          if (!hex || !CUSTOMER_ID) return;

          const normalizedHex = normalizeHex(hex);
          const wasFavorite = favoriteHexes.has(normalizedHex);

          if (wasFavorite) {
            favoriteHexes.delete(normalizedHex);
          } else {
            favoriteHexes.add(normalizedHex);
          }

          syncFavoritesIntoColors();
          rerenderCurrentView();

          try {
            const response = await fetch(`/apps/palette-data?action=toggleFavorite`, {
  method: 'POST',
  credentials: 'same-origin',
  headers: {
    'Content-Type': 'application/json'
  },
  body: JSON.stringify({
    customerId: CUSTOMER_ID,
    paletteCode: paletteCode,
    colorName: name,
    hex: hex
  })
});

const text = await response.text();
const result = text ? JSON.parse(text) : {};

            if (!response.ok || !result.success) {
              throw new Error(result.error || 'Failed to update favorite');
            }

            if (result.isFavorite) {
              favoriteHexes.add(normalizedHex);
            } else {
              favoriteHexes.delete(normalizedHex);
            }

            syncFavoritesIntoColors();
            rerenderCurrentView();
            messageEl.textContent = '';
          } catch (error) {
            console.error(error);

            if (wasFavorite) {
              favoriteHexes.add(normalizedHex);
            } else {
              favoriteHexes.delete(normalizedHex);
            }

            syncFavoritesIntoColors();
            rerenderCurrentView();
            messageEl.textContent = 'Could not update favorites right now.';
          }
        });
      });
    }

    function getDepthRank(color) {
      const depthValue = normalizeDepth(color.isNeutral ? color.neutralDepth : color.depth);

      if (depthValue === 'Light') return 1;
      if (depthValue === 'Medium') return 2;
      if (depthValue === 'Deep') return 3;
      return 99;
    }

    function syncFavoritesIntoColors() {
      renderedFlatColors = sourceAllColors.map(color => ({
        ...color,
        isFavorite: favoriteHexes.has(normalizeHex(color.hex))
      }));

      const regrouped = {};

      renderedFlatColors.forEach(color => {
        if (color.isFavorite) {
          if (!regrouped['Favorites']) regrouped['Favorites'] = [];
          regrouped['Favorites'].push(color);
        }

        if (color.isBest) {
          if (!regrouped['Best']) regrouped['Best'] = [];
          regrouped['Best'].push(color);
        }

        const category = String(color.category || '').trim();
        if (category) {
          if (!regrouped[category]) regrouped[category] = [];
          regrouped[category].push(color);
        }
      });

      Object.keys(regrouped).forEach(category => {
        regrouped[category].sort((a, b) => {
          if (category === 'Neutrals') {
            const aDepth = getDepthLabel(a);
            const bDepth = getDepthLabel(b);

            const aIsLight = aDepth === 'Light';
            const bIsLight = bDepth === 'Light';

            if (aIsLight && !bIsLight) return -1;
            if (!aIsLight && bIsLight) return 1;

            if (aIsLight && bIsLight) {
              return (a.sortOrder || 0) - (b.sortOrder || 0);
            }

            const aFamily = getNeutralFamily(a) || 'Other Neutrals';
            const bFamily = getNeutralFamily(b) || 'Other Neutrals';

            const neutralFamilyOrder = [
              'Creams',
              'Olive Greens',
              'Mustard & Golden Olives',
              'Browns',
              'Taupes',
              'Navy Blues',
              'Grays'
            ];

            const aIndex = neutralFamilyOrder.findIndex(name => name.toLowerCase() === aFamily.toLowerCase());
            const bIndex = neutralFamilyOrder.findIndex(name => name.toLowerCase() === bFamily.toLowerCase());

            if (aIndex !== -1 && bIndex !== -1 && aIndex !== bIndex) {
              return aIndex - bIndex;
            }
            if (aIndex !== -1 && bIndex === -1) return -1;
            if (aIndex === -1 && bIndex !== -1) return 1;

            const familyCompare = aFamily.localeCompare(bFamily);
            if (familyCompare !== 0) return familyCompare;

            return (a.sortOrder || 0) - (b.sortOrder || 0);
          }

          const depthCompare = getDepthRank(a) - getDepthRank(b);
          if (depthCompare !== 0) return depthCompare;

          return (a.sortOrder || 0) - (b.sortOrder || 0);
        });
      });

      renderedGrouped = regrouped;

      renderedOrderedCategories = [
        ...categoryOrder.filter(cat => regrouped[cat]),
        ...Object.keys(regrouped).filter(cat => !categoryOrder.includes(cat))
      ];
    }

    function rerenderCurrentView() {
      renderSections(renderedGrouped, renderedOrderedCategories, renderedFlatColors);

      if (!renderedFlatColors.length) {
        navEl.innerHTML = '';
        messageEl.textContent = 'No colors found.';
        return;
      }

      if (currentViewMode === 'compact') {
        navEl.innerHTML = '';
      } else {
        const savedCategory = isCustomPaletteCode
          ? 'All'
          : (sessionStorage.getItem(`ycsActiveCategory_${paletteCode}`) || 'All');
        const restoredCategory =
          renderedOrderedCategories.includes(savedCategory) || savedCategory === 'All'
            ? savedCategory
            : 'All';

        renderCategoryNav(renderedOrderedCategories, restoredCategory);
        setActiveCategory(restoredCategory, renderedOrderedCategories);
      }

      attachSwatchClickHandlers(renderedFlatColors);
      attachFavoriteHandlers();
      messageEl.textContent = '';
    }

    function applyViewMode(mode) {
      currentViewMode = mode;

      if (mode === 'compact') {
        app.classList.add('is-compact-palette');
      } else {
        app.classList.remove('is-compact-palette');
      }

      if (scanToggleEl) {
        const isActive = mode === 'compact';
        scanToggleEl.classList.toggle('is-active', isActive);
        scanToggleEl.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      }

      sessionStorage.setItem(viewModeStorageKey, mode);

      if (renderedOrderedCategories.length || renderedFlatColors.length) {
        rerenderCurrentView();
      }
    }

    if (scanToggleEl) {
      scanToggleEl.addEventListener('click', function () {
        const nextMode = currentViewMode === 'compact' ? 'labeled' : 'compact';
        applyViewMode(nextMode);
      });
    }

    if (downloadPalettePngsEl) {
      downloadPalettePngsEl.addEventListener('click', downloadPalettePngs);
    }

    if (navEl) {
      navEl.addEventListener('scroll', updateCategoryNavFade);
      window.addEventListener('resize', updateCategoryNavFade);
    }

    async function loadFavorites() {
  if (!CUSTOMER_ID) return new Set();

  try {
    const response = await fetch(
      `/apps/palette-data?action=getFavorites&customerId=${encodeURIComponent(CUSTOMER_ID)}&palette=${encodeURIComponent(paletteCode)}`,
      { credentials: 'same-origin' }
    );

    const text = await response.text();
    const data = text ? JSON.parse(text) : {};

    if (!response.ok) {
      throw new Error(data.error || 'Could not load favorites');
    }

    return new Set((data.favorites || []).map(normalizeHex));
  } catch (error) {
    console.error(error);
    return new Set();
  }
}

    async function loadColors() {
      titleEl.textContent = isCustomPaletteCode
        ? 'Loading Palette'
        : (paletteNameMap[paletteCode] || paletteCode);
      subtitleEl.textContent = '';

      applyViewMode(currentViewMode);

      messageEl.textContent = 'Loading colors...';
      sectionsEl.innerHTML = `
        <div class="ycs-swatch-grid">
          ${Array.from({ length: 12 }).map(() => `
            <div class="ycs-swatch-skeleton"></div>
          `).join('')}
        </div>
      `;

      try {
        const loadedFavorites = await loadFavorites();

        favoriteHexes = loadedFavorites;

        let data;
        if (isCustomPaletteCode) {
          data = await fetchCustomPaletteForViewer();
        } else if (isAdminAggregatePalette) {
          data = await fetchAdminAggregatePaletteForViewer();
        } else {
          data = {
            paletteName: paletteNameMap[paletteCode] || paletteCode,
            colors: await fetchYcsPaletteColors(paletteCode, 0)
          };
        }

        if (!data.colors) {
          throw new Error(data.error || 'No colors returned');
        }

        if (data.paletteName) {
          currentPaletteExportName = data.paletteName;
        }

        if (data.paletteName && isCustomPaletteCode) {
          titleEl.textContent = data.paletteName;
        }

        const allColors = data.colors.map(color => ({
          ...color,
          isFavorite: favoriteHexes.has(normalizeHex(color.hex))
        }));

        if (!allColors.length) {
          messageEl.textContent = isCustomPaletteCode
            ? 'No colors found for this palette.'
            : `No colors found for ${paletteCode}.`;
          navEl.innerHTML = '';
          sectionsEl.innerHTML = '';
          return;
        }

        sourceAllColors = allColors.slice();

        syncFavoritesIntoColors();
        rerenderCurrentView();
        if (downloadPalettePngsEl) downloadPalettePngsEl.disabled = false;

        const savedScroll = sessionStorage.getItem('paletteScroll');
        const lastHex = sessionStorage.getItem('ycsLastColorHex') || '';
        const lastName = sessionStorage.getItem('ycsLastColorName') || '';

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            let restored = false;

            if (lastHex && lastName) {
              const targetLink = Array.from(document.querySelectorAll('.ycs-swatch-link')).find(link =>
                (link.dataset.colorHex || '') === lastHex &&
                (link.dataset.colorName || '') === lastName
              );

              if (targetLink) {
                targetLink.scrollIntoView({
                  block: 'center',
                  inline: 'nearest',
                  behavior: 'auto'
                });
                restored = true;
              }
            }

            if (!restored && savedScroll) {
              window.scrollTo(0, Number(savedScroll));
            }

            sessionStorage.removeItem('paletteScroll');
            sessionStorage.removeItem('ycsLastColorHex');
            sessionStorage.removeItem('ycsLastColorName');
          });
        });

        messageEl.textContent = '';
      } catch (error) {
        console.error(error);
        messageEl.textContent = 'There was a problem loading this palette.';
        navEl.innerHTML = '';
        sectionsEl.innerHTML = '';
      }
    }

    loadColors();
  });
</script>
