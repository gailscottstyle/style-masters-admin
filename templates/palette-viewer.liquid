    border-radius: 999px;
    background: #fff;
    color: #444;
    font-size: 13px;
    line-height: 1;
    flex: 0 0 auto;
    cursor: pointer;
    font: inherit;
    transition: all 0.15s ease;
    text-decoration: none;
  }

  .ycs-category-link:hover {
    border-color: #999;
    color: #111;
  }

  .ycs-category-link.is-active {
    background: #444;
    color: #fff;
    border-color: #444;
  }

  .ycs-category-link.is-active:hover {
    color: #fff;
    border-color: #444;
