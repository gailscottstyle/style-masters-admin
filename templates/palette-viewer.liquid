    left: 0;
    background: linear-gradient(to right, #fff, rgba(255,255,255,0));
  }

  .ycs-category-nav-wrap::after {
    right: 0;
    background: linear-gradient(to left, #fff, rgba(255,255,255,0));
  }

  .ycs-category-nav-wrap.is-left-hidden::before {
    opacity: 0;
  }

  .ycs-category-nav-wrap.is-right-hidden::after {
    opacity: 0;
  }

