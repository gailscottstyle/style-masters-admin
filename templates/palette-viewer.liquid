}

  .ycs-view-toggle {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
  }

  .ycs-scan-toggle {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 10px;
    background: #444;
    color: #fff;
    cursor: pointer;
    transition: transform .15s ease, background .15s ease;
  }

  .ycs-scan-toggle:hover {
    background: #2f2f2f;
    transform: translateY(-1px);
  }

  .ycs-scan-toggle.is-active {
    background: #111;
  }

  .ycs-scan-toggle svg {
    fill: currentColor;
    display: block;
  }

  .ycs-icon-list {
    display: none;
  }

  .ycs-scan-toggle.is-active .ycs-icon-grid {
    display: none;
  }

  .ycs-scan-toggle.is-active .ycs-icon-list {
    display: block;
  }

  .ycs-category-nav {
    display: flex;
    flex: 1 1 auto;
    gap: 8px;
    overflow-x: auto;
    white-space: nowrap;
    margin: 0;
    padding: 0;
    scrollbar-width: none;
    background: transparent;
  }

  .ycs-category-nav::-webkit-scrollbar {
    display: none;
  }

  .ycs-category-link {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 7px 12px;
