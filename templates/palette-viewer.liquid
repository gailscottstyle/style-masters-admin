  .ycs-palette-app.is-compact-palette .ycs-section-header {
    display: none;
  }

  .ycs-palette-app.is-compact-palette .ycs-depth-group__title {
    display: none;
  }

  .ycs-palette-app.is-compact-palette .ycs-depth-group {
    margin: 0;
  }

  .ycs-palette-app.is-compact-palette .ycs-swatch-grid {
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 4px;
  }

  @media (min-width: 700px) {
    .ycs-palette-app.is-compact-palette .ycs-swatch-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
  }

