{% assign palette_access_string = '' %}
{% if customer %}
  {% assign palette_access_string = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
{% endif %}

{% capture ycs_header_content %}{{ content_for_header }}{% endcapture %}
{% assign ycs_page_url = ycs_header_content
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | replace: '\/', '/'
  | replace: '\\u0026', '&'
  | replace: '%26', '&'
  | replace: '%3F', '?'
  | replace: '%3D', '='
  | append: '&'
%}

{% assign is_admin = false %}
{% if customer and palette_access_string contains ',YCS_ADMIN,' %}
  {% assign is_admin = true %}
{% endif %}
{% assign actual_is_admin = is_admin %}

{% assign is_trade_july_cohort = false %}
{% assign trade_july_cohort_expires_at = '2026-08-25 00:00:00 -0400' | date: '%s' %}
{% assign current_timestamp = 'now' | date: '%s' %}
{% if customer and palette_access_string contains ',TRADEJULYCOHORT,' and current_timestamp < trade_july_cohort_expires_at %}
  {% assign is_trade_july_cohort = true %}
{% endif %}

{% assign is_trade = false %}
{% if customer and palette_access_string contains ',TRADE,' %}
  {% assign is_trade = true %}
{% endif %}
{% if is_trade_july_cohort %}
  {% assign is_trade = true %}
{% endif %}

{% assign is_catool = false %}
{% if customer and palette_access_string contains ',CATOOL,' %}
  {% assign is_catool = true %}
{% endif %}

{% assign is_catool_growth = false %}
{% if customer and palette_access_string contains ',CATOOLGROWTH,' %}
  {% assign is_catool_growth = true %}
{% endif %}

{% assign admin_view_as = '' %}
{% if actual_is_admin %}
  {% if ycs_page_url contains 'viewAs=trade&' %}
    {% assign admin_view_as = 'trade' %}
  {% elsif ycs_page_url contains 'viewAs=catoolgrowth&' %}
    {% assign admin_view_as = 'catoolgrowth' %}
  {% elsif ycs_page_url contains 'viewAs=catool&' %}
    {% assign admin_view_as = 'catool' %}
  {% endif %}
{% endif %}

{% if admin_view_as != '' %}
  {% assign is_admin = false %}
  {% assign is_trade = false %}
  {% assign is_catool = false %}
  {% assign is_catool_growth = false %}

  {% if admin_view_as == 'trade' %}
    {% assign is_trade = true %}
  {% elsif admin_view_as == 'catoolgrowth' %}
    {% assign is_catool_growth = true %}
  {% elsif admin_view_as == 'catool' %}
    {% assign is_catool = true %}
  {% endif %}
{% endif %}

{% assign can_manage_clients = false %}
{% if is_admin or is_trade or is_catool or is_catool_growth %}
  {% assign can_manage_clients = true %}
{% endif %}

{% assign can_create_reports = false %}
{% if actual_is_admin or is_trade or is_catool or is_catool_growth %}
  {% assign can_create_reports = true %}
{% endif %}

<div
  class="ycs-clients"
  data-customer-id="{{ customer.id }}"
  data-can-manage-clients="{{ can_manage_clients }}"
  data-can-create-reports="{{ can_create_reports }}"
  data-app-base-url=""
>
  {% if customer == nil %}
    <div class="ycs-clients__empty">
      <h1>Sign in to access Clients & Members</h1>
      <a href="{{ routes.account_login_url }}" class="ycs-clients__button">Sign In</a>
    </div>
  {% elsif can_manage_clients == false %}
    <div class="ycs-clients__empty">
      <h1>Access denied</h1>
      <p>This page is available with Trade, CATOOL, CATOOLGROWTH, and admin access.</p>
    </div>
  {% else %}
    <div class="ycs-clients__topbar">
      <nav class="ycs-clients__nav" aria-label="Color analysis tools">

        <a
          href="/clients?view=catools{% if admin_view_as != '' %}&viewAs={{ admin_view_as }}{% endif %}"
          class="ycs-clients__back-link"
          data-ycs-clients-back-link
          data-tools-href="/clients?view=catools{% if admin_view_as != '' %}&viewAs={{ admin_view_as }}{% endif %}"
          data-ycs-leave-client-view
        >Clients & Members</a>
        <a
          href="/clients{% if admin_view_as != '' %}?viewAs={{ admin_view_as }}{% endif %}"
          class="ycs-clients__back-link is-active"
          data-ycs-clients-nav-selected
          data-ycs-leave-client-view
          hidden
        >Clients & Members</a>
        <a
          href="/pages/photo-prep?mode=trade&workflow=color-analysis{% if admin_view_as != '' %}&viewAs={{ admin_view_as }}{% endif %}"
          class="ycs-clients__back-link"
          data-ycs-clients-nav-photo-prep
          data-ycs-leave-client-view
          hidden
        >Photo Prep</a>
        <a
          href="/pages/color-analysis-tool{% if admin_view_as != '' %}?viewAs={{ admin_view_as }}{% endif %}"
          class="ycs-clients__back-link"
          data-ycs-clients-nav-structured
          data-ycs-leave-client-view
          hidden
        >Structured Analysis</a>
        <a
          href="/pages/signature-color-analysis{% if admin_view_as != '' %}?viewAs={{ admin_view_as }}{% endif %}"
          class="ycs-clients__back-link"
          data-ycs-clients-nav-lip
          data-ycs-leave-client-view
          hidden
        >Lip & Draping Studio</a>
      </nav>
    </div>

    <div class="ycs-clients__header">
      <div>
        <p class="ycs-clients__eyebrow">Style Masters</p>
        <h1 class="ycs-clients__title">Clients & Members</h1>
        <p class="ycs-clients__subtitle">Manage your clients and members, photos, and color analysis.</p>
      </div>
      <a href="/clients?newClient=1{% if admin_view_as != '' %}&viewAs={{ admin_view_as }}{% endif %}" class="ycs-clients__button" data-ycs-add-client>Add Customer</a>
    </div>

    <div class="ycs-clients__toolbar" data-ycs-client-list-controls>
      <input
        type="search"
        class="ycs-clients__search"
        placeholder="Search by name or email"
        autocomplete="off"
        data-ycs-client-search
      />
      <label class="sm-filter-label">Show<select class="ycs-clients__select" data-sm-customer-filter aria-label="Customer group"><option value="all">All Customers</option><option value="clients">My Clients</option><option value="members">All Members</option><option value="active">Active Members</option><option value="inactive">Inactive Members</option></select></label><select class="ycs-clients__select" data-ycs-client-palette-filter hidden>
        <option value="all">All palettes</option>
        <option value="unassigned">Unassigned</option>
      </select>
      <select class="ycs-clients__select" data-ycs-client-sort aria-label="Sort customers">
        <option value="updated-desc">Recently Updated</option>
        <option value="newest">Newest</option>
        <option value="oldest">Oldest</option>
        <option value="first-name">First Name A-Z</option>
        <option value="last-name">Last Name A-Z</option>
      </select>
    </div>

    <div class="ycs-clients__status" data-ycs-client-status>Loading clients...</div>
    <div class="ycs-clients__grid" data-ycs-client-grid></div>
    <div class="ycs-clients__detail" data-ycs-client-detail hidden></div>
  {% endif %}
</div>

{{ 'ycs-my-clients.js' | asset_url | script_tag }}

<style>
  .shopify-section-header,
  #shopify-section-header,
  .site-header,
  .header-wrapper,
  .header,
  nav[role="navigation"],
  #shopify-section-footer,
  .shopify-section--footer,
  .site-footer,
  footer.footer,
  footer[role="contentinfo"] {
    display: none !important;
  }

  .bredcrumbWrap {
    display: none !important;
  }

  .ycs-clients {
    max-width: 1240px;
    margin: 0 auto;
    padding: 18px;
    color: #2f2a25;
  }

  .ycs-clients__topbar {
    margin-bottom: 10px;
  }

  .ycs-clients__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .ycs-clients__back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    border: 1px solid #e6ded5;
    border-radius: 999px;
    background: #fff;
    color: #2f2a25;
    font-size: 14px;
    font-weight: 800;
    line-height: 1;
    padding: 0 18px;
    text-decoration: none;
  }

  .ycs-clients__back-link:hover,
  .ycs-clients__back-link.is-active {
    border-color: #111;
    background: #111;
    color: #fff;
  }

  .ycs-clients__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 14px;
  }

  .ycs-clients__eyebrow {
    margin: 0 0 6px;
    color: #8b7d6b;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ycs-clients__title {
    margin: 0 0 6px;
    font-size: 28px;
    line-height: 1.08;
  }

  .ycs-clients__subtitle {
    margin: 0;
    color: #5f5a54;
    font-size: 14px;
  }

  .ycs-clients__toolbar {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .ycs-clients__search,
  .ycs-clients__select,
  .ycs-clients__input,
  .ycs-clients__textarea {
    min-height: 44px;
    border: 1px solid #ddd3c8;
    border-radius: 12px;
    background: #fff;
    color: #2f2a25;
    font: inherit;
    padding: 10px 14px;
  }

  .ycs-clients__search {
    flex: 1 1 320px;
  }

  .ycs-clients__status,
  .ycs-clients__empty {
    border: 1px solid #ece7df;
    background: #fffdf9;
    border-radius: 18px;
    padding: 24px;
    text-align: center;
    color: #625c55;
  }

  .ycs-clients__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }

  .ycs-client-card {
    border: 1px solid #ece7df;
    border-radius: 18px;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0,0,0,.04);
  }

  .ycs-client-card__photo {
    position: relative;
    height: 150px;
    background: #f6f1ea;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ycs-client-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ycs-client-card__placeholder {
    width: calc(100% - 24px);
    height: calc(100% - 24px);
    border: 2px dashed #d8cfc3;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8a8176;
    font-size: 14px;
    text-align: center;
    padding: 12px;
    background: #fffaf4;
  }

  a.ycs-client-card__placeholder {
    color: #2f2a25;
    font-weight: 800;
    text-decoration: none;
  }

  a.ycs-client-card__placeholder:hover {
    border-color: #111;
  }

  .ycs-client-card__content {
    padding: 14px;
  }

  .ycs-client-card__name {
    margin: 0 0 5px;
    font-size: 20px;
    line-height: 1.15;
  }

  .ycs-client-card__email,
  .ycs-client-card__date {
    margin: 0 0 8px;
    color: #746b62;
    font-size: 13px;
    line-height: 1.35;
    word-break: break-word;
  }

  .ycs-client-card__palette {
    margin: 0 0 10px;
    color: #2f2a25;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.35;
  }

  .ycs-client-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0 0 12px;
  }

  .ycs-client-badge {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    border-radius: 999px;
    padding: 0 9px;
    background: #f6f1ea;
    color: #5f5348;
    font-size: 12px;
    font-weight: 800;
  }

  .ycs-client-badge--palette {
    background: #f6f1ea;
    color: #5f5348;
  }

  .ycs-client-card__actions,
  .ycs-clients__detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .ycs-clients__button,
  .ycs-client-card__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    border: 0;
    border-radius: 999px;
    background: #111;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    padding: 0 16px;
    text-decoration: none;
  }

  .ycs-client-card__button--secondary,
  .ycs-clients__button--secondary {
    background: #efe7dc;
    color: #2f2a25;
  }

  .ycs-client-card__button--danger,
  .ycs-clients__button--danger {
    background: #fff5f7;
    color: #bd3155;
    border: 1px solid #f2c8d3;
  }

  .ycs-clients__detail {
    border: 1px solid #ece7df;
    border-radius: 18px;
    background: #fff;
    padding: 18px;
    box-shadow: 0 8px 24px rgba(0,0,0,.04);
  }

  .ycs-clients__detail-header {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 18px;
    align-items: start;
  }

  .ycs-clients__detail-header--edit {
    gap: 14px;
  }

  .ycs-clients__detail-photo {
    min-height: 260px;
    border-radius: 14px;
    background: #f6f1ea;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  button.ycs-clients__detail-photo,
  a.ycs-clients__detail-photo {
    width: 100%;
    border: 1px solid #e6ded5;
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: 0;
    text-decoration: none;
  }

  button.ycs-clients__detail-photo:hover,
  a.ycs-clients__detail-photo:hover {
    border-color: #111;
    background: #fbfaf8;
  }

  .ycs-clients__upload-photo-button {
    width: 100%;
    margin-top: 10px;
  }

  .ycs-clients__detail-photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ycs-clients__detail h2 {
    margin: 0 0 6px;
    font-size: 30px;
  }

  .ycs-clients__detail-meta {
    color: #625c55;
    line-height: 1.5;
  }

  .ycs-clients__detail-meta--edit {
    font-size: 13px;
    line-height: 1.35;
  }

  .ycs-clients__photo-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin-top: 18px;
  }

  .ycs-clients__photo-list figure {
    margin: 0;
    border: 1px solid #ece7df;
    border-radius: 14px;
    overflow: hidden;
    background: #fffdf9;
  }

  .ycs-clients__photo-list img {
    width: 100%;
    height: 180px;
    object-fit: contain;
    display: block;
    background: #f6f1ea;
  }

  .ycs-clients__photo-list figcaption {
    padding: 9px 10px;
    font-size: 13px;
    font-weight: 800;
    color: #5f5348;
  }

  .ycs-client-photo-manager {
    margin-top: 18px;
  }

  .ycs-client-photo-manager[hidden] {
    display: none;
  }

  .ycs-client-photo-manager__panel {
    border: 1px solid #ece7df;
    border-radius: 16px;
    background: #fffdf9;
    padding: 16px;
  }

  .ycs-client-photo-manager__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ycs-client-photo-manager__head h3 {
    margin: 0 0 4px;
    font-size: 20px;
  }

  .ycs-client-photo-manager__head p,
  .ycs-client-photo-manager__status {
    margin: 0;
    color: #625c55;
    font-size: 13px;
  }

  .ycs-client-photo-manager__status {
    margin-top: 10px;
  }

  .ycs-client-photo-manager__status--error {
    color: #bd3155;
    font-weight: 800;
  }

  .ycs-client-photo-manager__select-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    color: #5f5348;
    font-size: 13px;
    font-weight: 800;
  }

  .ycs-client-photo-manager__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
    margin-top: 12px;
  }

  .ycs-client-photo-manager__card {
    position: relative;
    overflow: hidden;
    border: 1px solid #ece7df;
    border-radius: 14px;
    background: #fff;
  }

  .ycs-client-photo-manager__card img {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: contain;
    background: #f6f1ea;
  }

  .ycs-client-photo-manager__check {
    position: absolute;
    top: 8px;
    left: 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border-radius: 999px;
    background: rgba(255, 255, 255, .92);
    color: #2f2a25;
    font-size: 12px;
    font-weight: 800;
    padding: 5px 8px;
  }

  .ycs-client-photo-manager__body {
    display: grid;
    gap: 7px;
    padding: 10px;
  }

  .ycs-client-photo-manager__body strong {
    color: #2f2a25;
    font-size: 13px;
    line-height: 1.25;
  }

  .ycs-client-photo-manager__body small {
    color: #7a6e63;
    font-size: 12px;
  }

  .ycs-clients__edit-form {
    display: grid;
    gap: 7px;
    margin-top: 10px;
    max-width: 480px;
  }

  .ycs-clients__edit-form .ycs-clients__input {
    min-height: 38px;
    padding: 8px 12px;
  }

  .ycs-clients__form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ycs-clients__form-actions .ycs-clients__button {
    flex: 1 1 180px;
  }

  .ycs-clients__textarea {
    min-height: 78px;
    resize: vertical;
  }

  .ycs-clients__save-message {
    margin: 0;
    color: #4f8a5f;
    font-size: 13px;
    font-weight: 800;
  }

  .ycs-clients-discard {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(47, 42, 37, 0.45);
    padding: 18px;
  }

  .ycs-clients-discard__dialog {
    width: min(440px, 100%);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 18px 48px rgba(0,0,0,.18);
    padding: 22px;
  }

  .ycs-clients-discard__dialog h2 {
    margin: 0 0 8px;
    font-size: 26px;
  }

  .ycs-clients-discard__dialog p {
    margin: 0 0 18px;
    color: #625c55;
    font-size: 16px;
  }

  .ycs-clients-discard__actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }

  .ycs-report-builder {
    margin-top: 22px;
    border-top: 1px solid #ece7df;
    padding-top: 22px;
  }

  .ycs-report-builder__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }

  .ycs-report-builder__header h3 {
    margin: 0 0 6px;
    font-size: 24px;
    line-height: 1.15;
  }

  .ycs-report-builder__header p,
  .ycs-report-builder__status {
    margin: 0;
    color: #625c55;
    font-size: 14px;
  }

  .ycs-report-builder__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-end;
  }

  .ycs-report-builder__layout {
    display: grid;
    grid-template-columns: 154px minmax(250px, 320px) 1fr;
    gap: 18px;
    align-items: start;
    margin-top: 14px;
  }

  .ycs-report-form {
    display: grid;
    gap: 12px;
    max-height: 860px;
    overflow: auto;
    padding-right: 6px;
  }

  .ycs-report-form label {
    display: grid;
    gap: 6px;
    color: #4f463d;
    font-size: 13px;
    font-weight: 800;
  }

  .ycs-report-form input,
  .ycs-report-form select,
  .ycs-report-form textarea {
    width: 100%;
    min-height: 42px;
    border: 1px solid #ddd3c8;
    border-radius: 8px;
    background: #fff;
    color: #2f2a25;
    font: inherit;
    font-size: 14px;
    font-weight: 400;
    padding: 10px 12px;
  }

  .ycs-report-form textarea {
    min-height: 150px;
    resize: vertical;
    line-height: 1.45;
  }

  .ycs-report-form textarea.ycs-report-textarea--fill {
    height: calc(100vh - 280px);
    min-height: 520px;
  }

  .ycs-report-form-page {
    display: grid;
    gap: 12px;
  }

  .ycs-report-form-page__head {
    display: grid;
    gap: 2px;
    padding: 12px;
    border: 1px solid #e6ded5;
    border-radius: 8px;
    background: #f6f1ea;
  }

  .ycs-report-form-page__head span {
    color: #2f2a25;
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .ycs-report-form-page__head small {
    color: #716960;
    font-size: 12px;
    font-weight: 600;
  }

  .ycs-report-form-panel {
    display: grid;
    gap: 10px;
    padding: 12px;
    border: 1px solid #e6ded5;
    border-radius: 8px;
    background: #fbfaf8;
  }

  .ycs-report-form-panel__head {
    display: grid;
    gap: 2px;
  }

  .ycs-report-form-panel__head span {
    color: #4f463d;
    font-size: 13px;
    font-weight: 800;
  }

  .ycs-report-form-panel__head small,
